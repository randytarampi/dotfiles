{
  "version": 1,
  "common_flags": {
    "help": {
      "flag": "--help",
      "type": "boolean",
      "semantics": "print usage and exit 0",
      "required_for_capabilities": [
        "public"
      ]
    },
    "dry_run": {
      "flag": "--dry-run",
      "type": "boolean",
      "default": false,
      "semantics": "preview without writing to filesystem",
      "required_for_capabilities": [
        "mutates"
      ]
    },
    "no_backup": {
      "flag": "--no-backup",
      "type": "boolean",
      "default": false,
      "semantics": "disable backup file creation (backup-on default)",
      "required_for_capabilities": [
        "backups"
      ]
    },
    "preset": {
      "flag": "--preset",
      "type": "string",
      "metavar": "TIER",
      "semantics": "AI model tier preset",
      "required_for_capabilities": [
        "tier_selector"
      ]
    },
    "mode": {
      "flag": "--mode",
      "type": "choice",
      "choices": [
        "global",
        "project"
      ],
      "semantics": "configuration scope",
      "required_for_capabilities": [
        "scope_selector"
      ]
    }
  },
  "local_fallback_flags": {
    "preset": {
      "flag": "--local-fallback-preset",
      "type": "string",
      "metavar": "PRESET"
    },
    "role": {
      "flag": "--local-fallback-role",
      "type": "string",
      "metavar": "ROLE",
      "repeatable": true
    },
    "placeholder": {
      "flag": "--local-fallback-placeholder",
      "type": "string",
      "metavar": "PLACEHOLDER",
      "repeatable": true
    }
  },
  "exit_codes": {
    "success": 0,
    "runtime_failure": 1,
    "usage_error": 2
  },
