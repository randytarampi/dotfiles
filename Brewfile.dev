# --- Taps ---
tap "alvinunreal/tap", trusted: true
tap "incoai/tap"
tap "jundot/omlx", "https://github.com/jundot/omlx"
tap "qltysh/tap"

# OpenCode is managed by its official installer, not Homebrew.
# See docs/OPENCODE-V2-MIGRATION-PLAN.md for channel and cutover policy.

# --- Languages & build ---
brew "alpine"
brew "ant"
brew "autoconf"
brew "automake"
brew "cmake"
brew "cython"
brew "erlang"
brew "gradle"
brew "jenv"
brew "makedepend"
brew "maven"
brew "meson"
brew "nim"
brew "pipenv"
brew "pipx"
brew "pkgconf"
brew "pyenv"
brew "pyenv-virtualenv"
brew "python@3.10"
brew "python@3.11"
brew "r"
brew "rbenv"
brew "ruby-build"
brew "rust"
brew "scons"
brew "swig"
brew "tfenv"

# --- Facebook development ---
brew "edencommon"
brew "fb303"
brew "fbthrift", link: true
brew "fizz"
brew "folly"
brew "grpc"
brew "wangle"

# --- AI & agent tools ---
brew "github-mcp-server"
brew "hermes-agent"
brew "incoai/tap/splash", trusted: true
brew "jundot/omlx/omlx"
brew "skills"

# --- Mobile development ---
brew "carthage"
brew "cocoapods"
brew "facebook/fb/idb-companion"
brew "fastlane"
brew "ios-deploy"
brew "libimobiledevice"
brew "wix/brew/applesimutils"

# --- Databases & geospatial ---
brew "apache-arrow"
brew "gdal"
brew "libpq", link: true
brew "librttopo"
brew "mapnik"
brew "microsoft/mssql-release/msodbcsql18"
brew "microsoft/mssql-release/mssql-tools18"
brew "mongodb/brew/mongodb-community"
brew "mongodb/brew/mongodb-database-tools"

# --- Audio, video & graphics ---
brew "aom"
brew "espeak-ng"
brew "exiftool"
brew "faac"
brew "ffmpeg"
brew "ffmpeg@4"
brew "gd"
brew "giflib"
brew "graphicsmagick"
brew "graphviz"
brew "imagemagick"
brew "jasper"
brew "libgsm"
brew "libheif"
brew "libicns"
brew "librsvg"
brew "libvo-aacenc"
brew "numpy"
brew "opencv"
brew "openrtsp"
brew "poppler"
brew "rtmpdump"
brew "sane-backends"
brew "sox"
brew "speex"
brew "svgo"
brew "vtk"
brew "whisper.cpp"

# --- Security & credentials ---
brew "gnutls"
brew "gsasl"
brew "libksba"
brew "nss"
brew "pinentry"
brew "pinentry-mac"
brew "snyk/tap/snyk"

# --- Development, testing & quality ---
brew "act"
brew "actionlint"
brew "bats-core"
brew "bfg"
brew "black"
brew "circleci"
brew "cppcheck"
brew "gauge"
brew "git-filter-repo"
brew "git-lfs"
brew "gradle-completion"
brew "phrase/brewed/phraseapp"
brew "pre-commit"
brew "qltysh/tap/qlty", trusted: true
brew "shellcheck"
brew "shfmt"
brew "stripe-cli"
brew "travis"
brew "vale"
brew "watchman"

# --- Terminal, editors & documentation ---
brew "cask"
brew "croc"
brew "diskonaut"
brew "docbook"
brew "emacs", restart_service: :changed
brew "fastfetch"
brew "felinks"
brew "glow"
brew "httpie"
brew "hyfetch"
brew "lynx"
brew "nb"
brew "nnn"
brew "nvtop"
brew "pandoc"
brew "parallel"
brew "powershell"
brew "texi2html"
brew "wimlib"

# --- Libraries & system dependencies ---
brew "boost"
brew "cabextract"
brew "dbus"
brew "dfu-util"
brew "e2fsprogs"
brew "gettext"
brew "gmp"
brew "gptfdisk"
brew "gtk+"
brew "gtk+3"
brew "hicolor-icon-theme"
brew "icu4c@78"
brew "libevent"
brew "libusb"
brew "libusb-compat"
brew "libxml2"
brew "miniupnpc"
brew "net-snmp"
brew "nghttp2"
brew "pth"
brew "pyqt"
brew "qt"
brew "shared-mime-info"
brew "zlib"

# --- CLI casks ---
cask "alvinunreal/tap/lazyskills"
cask "antigravity-cli"
cask "claude-code"
cask "codex"
cask "copilot-cli"
cask "sentry-cli"

# --- uv packages ---
uv "piper-tts"

# --- npm packages ---
npm "@agentclientprotocol/claude-agent-acp"
npm "@agentclientprotocol/codex-acp"
npm "@colbymchenry/codegraph"
npm "@earendil-works/pi-coding-agent"
