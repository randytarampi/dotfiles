#!/bin/bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"

{{- if eq .chezmoi.os "darwin" }}

# Gate on DOTFILES_RUN_MACOS_DEFAULTS env var (set in ~/.env)
if [[ "${DOTFILES_RUN_MACOS_DEFAULTS:-0}" != "1" ]]; then
  info "DOTFILES_RUN_MACOS_DEFAULTS='${DOTFILES_RUN_MACOS_DEFAULTS:-0}' — skipping macOS defaults"
  exit 0
fi

info "Configuring macOS defaults..."
# Keyboard
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Finder
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder AppleShowAllFiles -bool true

# Dock
defaults write com.apple.dock autohide -bool true

# Screenshots
defaults write com.apple.screencapture location ~/Downloads
ok "macOS defaults configured."
{{- end }}
