#!/usr/bin/env bash
set -euo pipefail

# ─── run_onchange_10-install-antigravity-acp.sh.tmpl ──────────────────────────
# Installs the antigravity-acp bridge (prebuilt binary, agy-acp).
# Gated on DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP=1 in ~/.env.
# ──────────────────────────────────────────────────────────────────────────────

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Script hash triggers (re-run when installer changes):
# scripts/install-antigravity-acp.sh: {{ include "scripts/install-antigravity-acp.sh" | sha256sum }}

# Load environment for API keys
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP='${DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP:-0}' — skipping antigravity-acp installation"
  exit 0
fi

INSTALL_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/install-antigravity-acp.sh"
if [[ -f "$INSTALL_SCRIPT" ]]; then
  bash "$INSTALL_SCRIPT"
else
  warn "install-antigravity-acp.sh not found; skipping antigravity-acp installation"
fi
