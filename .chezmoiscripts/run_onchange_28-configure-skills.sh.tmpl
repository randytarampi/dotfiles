#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Script hash triggers (re-run when skills manifest, lib, or script change):
# configs/skills/skills.json: {{ include "configs/skills/skills.json" | sha256sum }}
# configs/skills/skills.core.json: {{ include "configs/skills/skills.core.json" | sha256sum }}
# configs/skills/skills.mattpocock.json: {{ include "configs/skills/skills.mattpocock.json" | sha256sum }}
# configs/skills/skills.aws.json: {{ include "configs/skills/skills.aws.json" | sha256sum }}
# configs/skills/skills.mongodb.json: {{ include "configs/skills/skills.mongodb.json" | sha256sum }}
# configs/skills/skills.prisma.json: {{ include "configs/skills/skills.prisma.json" | sha256sum }}
# configs/skills/dotfiles-verify/SKILL.md: {{ include "configs/skills/dotfiles-verify/SKILL.md" | sha256sum }}
# scripts/configure-skills.py: {{ include "scripts/configure-skills.py" | sha256sum }}
# scripts/lib/skills_manifest.py: {{ include "scripts/lib/skills_manifest.py" | sha256sum }}

# Load env before gate (DOTFILES_RUN_SKILLS_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_SKILLS_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_SKILLS_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_SKILLS_SETUP='${DOTFILES_RUN_SKILLS_SETUP:-0}' — skipping skills distribution"
  exit 0
fi

info "Reconciling skills against manifest..."
"{{ .chezmoi.sourceDir }}/scripts/configure-skills.py"
ok "Skills reconciled."
