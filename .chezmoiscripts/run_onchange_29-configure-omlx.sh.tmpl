#!/usr/bin/env bash
set -euo pipefail

# .chezmoiscripts/run_onchange_29-configure-omlx.sh.tmpl: {{ include ".chezmoiscripts/run_onchange_29-configure-omlx.sh.tmpl" | sha256sum }}
# scripts/lib/local_engines.py: {{ include "scripts/lib/local_engines.py" | sha256sum }}
# scripts/lib/omlx.py: {{ include "scripts/lib/omlx.py" | sha256sum }}

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

load_env || warn "$HOME/.env not found, skipping env load"

if [[ "${DOTFILES_RUN_OMLX_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OMLX_SETUP='${DOTFILES_RUN_OMLX_SETUP:-0}' — skipping oMLX setup"
  exit 0
fi

if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
  info "oMLX is Apple-Silicon/macOS only — skipping"
  exit 0
fi

OMLX_DIR="$HOME/.omlx"
SETTINGS_PATH="$OMLX_DIR/settings.json"
mkdir -p "$OMLX_DIR"

export OMLX_SETTINGS_PATH="$SETTINGS_PATH"
PYTHONPATH="$LIB_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json
import os
import tempfile
from pathlib import Path

from local_engines import merge_omlx_settings

path = Path(os.environ["OMLX_SETTINGS_PATH"])
try:
    existing = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
except (OSError, json.JSONDecodeError):
    existing = {}
rendered = json.dumps(merge_omlx_settings(existing), indent=2) + "\n"
current = path.read_text(encoding="utf-8") if path.exists() else None
if current != rendered:
    if current is not None:
        bak = path.with_suffix(path.suffix + ".bak")
        bak.write_text(current, encoding="utf-8")
        bak.chmod(0o600)
    fd, temp_name = tempfile.mkstemp(dir=path.parent, prefix=".settings.", text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(rendered)
    os.chmod(temp_name, 0o600)
    os.replace(temp_name, path)
# auth.api_key may be persisted; enforce 0600 even when nothing changed.
path.chmod(0o600)
PY
ok "oMLX settings written to $SETTINGS_PATH"
CONFIGURED_PORT="$(python3 - <<'PY'
import json
from pathlib import Path

try:
    print(json.loads(Path.home().joinpath('.omlx/settings.json').read_text()).get('server', {}).get('port', ''))
except (OSError, ValueError):
    print('')
PY
)"
if [[ -n "${OMLX_PORT:-}" && "$CONFIGURED_PORT" != "$OMLX_PORT" ]]; then
  warn "oMLX settings server.port ($CONFIGURED_PORT) diverges from OMLX_PORT ($OMLX_PORT) — persisted settings are authoritative"
fi
# The Homebrew service plist does not inherit ~/.env; persisted settings are authoritative.

OMLX_STARTED=false
if ! command -v brew >/dev/null 2>&1; then
  warn "Homebrew not found — cannot manage oMLX service"
elif brew services info omlx 2>/dev/null | grep -Eqi 'running: (false|none)|not started'; then
  brew services start omlx
  ok "oMLX service started"
  OMLX_STARTED=true
else
  info "oMLX service already running or unavailable — leaving lifecycle unchanged"
fi

if [[ "$OMLX_STARTED" == true ]]; then
  OMLX_BASE_URL="${OMLX_BASE_URL:-http://${OMLX_HOST:-127.0.0.1}:${OMLX_PORT:-8000}}"
  OMLX_AUTH_ARGS=()
  [[ -n "${OMLX_API_KEY:-}" ]] && OMLX_AUTH_ARGS=(-H "Authorization: Bearer ${OMLX_API_KEY}")
  ready=false
  for _ in {1..60}; do
    if curl -fsS --max-time 2 "${OMLX_BASE_URL%/}/health" "${OMLX_AUTH_ARGS[@]+${OMLX_AUTH_ARGS[@]}}" >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  if [[ "$ready" == true ]]; then
    ok "oMLX health endpoint ready"
  else
    warn "oMLX health endpoint did not become ready within 60 seconds — continuing"
  fi
fi

# OLLAMA_KV_CACHE_TYPE → oMLX per-model TurboQuant KV: one canonical env
# name for KV cache type across both daemons (q8_0 → 8-bit, q4_0 → 4-bit;
# unset/f16 leaves per-model settings untouched — admin-UI managed).
export OMLX_MODEL_SETTINGS_PATH="$OMLX_DIR/model_settings.json"
export OMLX_TQ_FILE="$OMLX_DIR/.tq-changed"
PYTHONPATH="$LIB_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import os
from pathlib import Path

from local_engines import sync_turboquant_kv

changed = sync_turboquant_kv(Path(os.environ["OMLX_MODEL_SETTINGS_PATH"]))
with open(os.environ["OMLX_TQ_FILE"], "w") as handle:
    handle.write(str(changed))
PY
TQ_CHANGED="$(cat "$OMLX_TQ_FILE" 2>/dev/null || echo 0)"
rm -f "$OMLX_TQ_FILE"
if [[ "$TQ_CHANGED" != "0" ]]; then
  ok "OLLAMA_KV_CACHE_TYPE applied to $TQ_CHANGED oMLX model(s)"
  if command -v brew >/dev/null 2>&1; then
    brew services restart omlx || warn "brew services restart omlx failed — reload manually to apply TurboQuant"
  fi
else
  info "OLLAMA_KV_CACHE_TYPE: no oMLX per-model changes needed"
fi

ok "oMLX setup complete"
