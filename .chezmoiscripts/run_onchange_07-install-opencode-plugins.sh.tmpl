#!/usr/bin/env bash
set -euo pipefail
# env gate fingerprint: {{ env "DOTFILES_RUN_OPENCODE_TOOLS_SETUP" | sha256sum }}
# env gate fingerprint: {{ env "DOTFILES_RUN_VOICE_SETUP" | sha256sum }}
# env gate fingerprint: {{ env "DOTFILES_RUN_OPENCODE_PLUGIN_UPDATE" | sha256sum }}
# env gate fingerprint: {{ env "DOTFILES_RUN_UPDATE_SYSTEM_SETUP" | sha256sum }}
# configs/opencode/opencode-plugins.json: {{ include "configs/opencode/opencode-plugins.json" | sha256sum }}
# scripts/lib/opencode_plugins.py: {{ include "scripts/lib/opencode_plugins.py" | sha256sum }}
# scripts/lib/meridian_path.py: {{ include "scripts/lib/meridian_path.py" | sha256sum }}
# scripts/lib/opencode_host.py: {{ include "scripts/lib/opencode_host.py" | sha256sum }}
# scripts/lib/opencode_bin.sh: {{ include "scripts/lib/opencode_bin.sh" | sha256sum }}

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"
# Managed OpenCode binary resolver (chezmoi children cannot rely on paths.sh).
source "${LIB_DIR}/opencode_bin.sh"

# Load env before gate (DOTFILES_RUN_OPENCODE_TOOLS_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_OPENCODE_TOOLS_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OPENCODE_TOOLS_SETUP='${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}' — skipping opencode plugin setup"
  exit 0
fi

info "Installing opencode plugins..."

# add/@latest is deduplicated by OpenCode; ordinary make deploy does not
# refresh packages. Refresh is explicit in the managed update-system workflow.
parse_plugin_check() {
  local spec="$1" output="$2" expected_version="$3" current_only="${4:-0}" check_exit="${5:-0}" parsed
  parsed="$(printf '%s\n' "$output" | python3 -c '
import re, sys
spec, expected, current_only, check_exit = sys.argv[1:]
# Real-binary check lines print the RESOLVED package name, which may lose
# the npm scope ("@tarquinen/opencode-dcp" -> "opencode-dcp"), the @latest
# alias, or the repo-qualifier suffix of a Git source. Record from the
# 2.2.5 cutover: scoped packages can also resolve to the bare scope name
# ("@plannotator/opencode" -> "plannotator") and repo-derived ids drop the
# "opencode-"/"-v2" decoration ("opencode-tokenscope-v2" -> "tokenscope").
# Match any of these derived forms; the exactly-one-match + version/status
# strictness stays. Git-source plugins may also print a short SHA version
# ("opencode-vibeguard 934823e (current)").
spec_base = spec.rsplit("@", 1)[0]
names = {spec_base, spec_base.rsplit("/", 1)[-1]}
unscoped = spec_base.rsplit("/", 1)[-1]
if spec_base.startswith("@"):
    names.add(spec_base.lstrip("@").split("/", 1)[0])
def _decorations(name):
    stripped = name
    if stripped.startswith("opencode-"):
        stripped = stripped[len("opencode-"):]
    if stripped.endswith("-v2"):
        stripped = stripped[:-3]
    return stripped
for form in (spec_base, unscoped):
    names.add(_decorations(form))
    if "/" in form:
        names.add(_decorations(form.rsplit("/", 1)[-1]))
if spec_base.startswith("github:"):
    repo = spec_base.split("#", 1)[0].rsplit("/", 1)[-1]
    names.update({repo, repo[:-3] if repo.endswith("-v2") else repo})
# The TUI status section echoes the CONFIGURED spec text (alias included),
# e.g. "@tarquinen/opencode-dcp@latest 3.2.0 (current)", while the Server
# section resolves to a bare package name. Record the echo forms as well;
# the exactly-one-distinct-pair rule below stays strict.
names.add(spec)
names.add(spec_base + "@latest")
matches = []
for line in sys.stdin:
    match = re.fullmatch(r"\s*(\S+)\s+(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?|[0-9a-f]{7,40})\s+\((current|latest|check failed|update available)\)\s*", line.rstrip("\n"))
    if match and match.group(1) in names:
        matches.append((match.group(1), match.group(2), match.group(3)))
if not matches:
    print("ERROR: expected exactly one version/status line for " + spec, file=sys.stderr)
    sys.exit(2)
# The 2.2.5 CLI may print multiple status sections (Server and TUI) for the
# same plugin. Sections must agree: exactly one distinct (version, status)
# pair. Disagreeing sections are a real divergence and still fail closed.
pairs = {(version_, status_) for _, version_, status_ in matches}
if len(pairs) != 1:
    print("ERROR: ambiguous version/status lines for " + spec + ": " + ", ".join(
        version_ + " (" + status_ + ")" for version_, status_ in sorted(pairs)
    ), file=sys.stderr)
    sys.exit(2)
identity, version, status = matches[0]
# Only Git-sourced plugins resolve to short commit hashes. A non-Git plugin
# returning a SHA is not a concrete published-package version.
if re.fullmatch(r"[0-9a-f]{7,40}", version) and not spec_base.startswith("github:"):
    print("ERROR: unexpected Git SHA version for non-Git plugin " + spec, file=sys.stderr)
    sys.exit(2)
if status == "check failed":
    print("ERROR: plugin check reported failure for " + spec, file=sys.stderr)
    sys.exit(2)
if check_exit != "0":
    print("ERROR: plugin check command exited " + check_exit + " for " + spec, file=sys.stderr)
    sys.exit(2)
if expected and version != expected:
    print("ERROR: resolved version changed for " + spec + ": expected " + expected + ", got " + version, file=sys.stderr)
    sys.exit(2)
if status == "update available" and current_only != "1":
    # Recorded 2026-11-03 from the live 2.2.5 host: @plannotator/opencode
    # prints "(update available)" while configured with @latest. Ordinary
    # deploys do not refresh packages; the managed update lane refreshes
    # explicitly and its post-update recheck still requires (current).
    print("NOTE: " + spec + " is behind upstream (" + version + " installed); refresh runs in the managed update lane", file=sys.stderr)
if status != "current" and not (status in ("latest", "update available") and current_only != "1"):
    print("ERROR: plugin is not current for " + spec + ": " + status, file=sys.stderr)
    sys.exit(2)
print(version)
' "$spec" "$expected_version" "$current_only" "$check_exit")" || return 1
  printf '%s\n' "$parsed"
}

HOST_STATE="absent"
HOST_MAJOR=""
OC_MANAGED="$(opencode_managed_bin)"
if [[ -n "$OC_MANAGED" ]] || command -v opencode >/dev/null 2>&1; then
  HOST_INFO="$(PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 -c 'import opencode_host; print(" ".join(str(x) if x is not None else "" for x in opencode_host.resolve_opencode_host()))' 2>/dev/null || true)"
  read -r HOST_STATE HOST_MAJOR <<<"${HOST_INFO}"
fi
# Every v2 plugin command targets the managed binary; children inherit the
# resolution so plugin adds, checks and updates cannot resolve a stale
# PATH v1 when ~/.opencode/bin is outside this process's PATH.
export OPENCODE_MANAGED_BIN="${OPENCODE_MANAGED_BIN:-$OC_MANAGED}"
if [[ "${HOST_STATE}" != "known" || "${HOST_MAJOR}" != "2" ]]; then
  warn "OpenCode host is ${HOST_STATE:-unknown}${HOST_MAJOR:+ (major ${HOST_MAJOR})}; skipping v2 plugin commands."
  # OMO Slim uses its own installer and is intentionally retained on v1.
  PLUGIN_MANIFEST="{{ .chezmoi.sourceDir }}/configs/opencode/opencode-plugins.json"
  PLUGIN_SPECS=()
  while IFS= read -r plugin; do PLUGIN_SPECS+=("$plugin"); done < <(
    PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 - "$PLUGIN_MANIFEST" <<'PY'
import sys
from opencode_plugins import active_plugin_specs
for plugin in active_plugin_specs(sys.argv[1]): print(plugin)
PY
  )
  OH_MY_PLUGIN="${PLUGIN_SPECS[0]}"
  if command -v bun >/dev/null 2>&1; then
    echo n | bunx "$OH_MY_PLUGIN" install --background-subagents=yes 2>/dev/null || warn "oh-my-opencode-slim install failed (may already be installed)"
  else
    echo n | npx "$OH_MY_PLUGIN" install --background-subagents=yes 2>/dev/null || warn "oh-my-opencode-slim install failed (may already be installed)"
  fi
  exit 0
fi

# Read the checked-in manifest; the voice writer owns cli.json registration.
PLUGIN_MANIFEST="{{ .chezmoi.sourceDir }}/configs/opencode/opencode-plugins.json"
PLUGIN_SPECS=()
while IFS= read -r plugin; do
  PLUGIN_SPECS+=("$plugin")
done < <(
  PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 - "$PLUGIN_MANIFEST" <<'PY'
import sys
from opencode_plugins import active_plugin_specs
for plugin in active_plugin_specs(sys.argv[1]):
    print(plugin)
PY
)

# Install oh-my-opencode-slim via its dedicated installer (not opencode plugin)
# --background-subagents=yes enables background subagents during install
# Pipe 'n' to skip the "Star the repo on GitHub?" prompt
# OMO-Slim is the orchestrator (first manifest entry): a failed install is a
# hard failure (missing required plugin), not a "may already be installed".
info "Installing oh-my-opencode-slim..."
OH_MY_PLUGIN="${PLUGIN_SPECS[0]}"
PLUGIN_INSTALL_FAILED=0
if command -v bun &>/dev/null; then
  OMO_INSTALLER=(bunx)
else
  OMO_INSTALLER=(npx)
fi
if echo n | "${OMO_INSTALLER[@]}" "$OH_MY_PLUGIN" install --background-subagents=yes 2>/dev/null; then
  ok "oh-my-opencode-slim installed"
else
  warn "oh-my-opencode-slim install failed"
  PLUGIN_INSTALL_FAILED=1
fi
# oh-my installer above is the first manifest entry and is not an opencode plugin.
# opencode plugin add <module> — installs the plugin in OpenCode v2
PLUGINS=(
)
for plugin in "${PLUGIN_SPECS[@]}"; do
  [[ "$plugin" == "$OH_MY_PLUGIN" ]] || PLUGINS+=("$plugin")
done

for plugin in "${PLUGINS[@]}"; do
  if "${OC_MANAGED}" plugin add "${plugin}" 2>/dev/null; then
    ok "opencode plugin: ${plugin}"
  else
    warn "opencode plugin ${plugin} failed"
    PLUGIN_INSTALL_FAILED=1
  fi
done
if [[ "${PLUGIN_INSTALL_FAILED}" -ne 0 ]]; then
  die "One or more OpenCode plugins failed to install"
fi

CLI_PLUGIN_SPECS=()
while IFS= read -r plugin; do
  CLI_PLUGIN_SPECS+=("$plugin")
done < <(
  PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 - "$PLUGIN_MANIFEST" <<'PY'
import sys
from opencode_plugins import cli_plugin_specs
for plugin in cli_plugin_specs(sys.argv[1]):
    print(plugin)
PY
)

for plugin in "${CLI_PLUGIN_SPECS[@]}"; do
  if "${OC_MANAGED}" plugin add "${plugin}" 2>/dev/null; then
    ok "opencode CLI plugin: ${plugin}"
  else
    warn "opencode CLI plugin ${plugin} failed"
    PLUGIN_INSTALL_FAILED=1
  fi
done
if [[ "${PLUGIN_INSTALL_FAILED}" -ne 0 ]]; then
  die "One or more OpenCode CLI plugins failed to install"
fi

# OpenCode plugin checks resolve their configuration context from the working
# directory. From scratch contexts the 2.2.5 CLI intermittently reports
# false "Plugin is not configured" errors for globally configured plugins
# (recorded 2026-11-03 in the update lane) or prints partial status sections.
# Pin the context to $HOME and retry a bounded once on that known transient
# before failing closed.
cd "$HOME" || die "cannot enter $HOME for plugin checks"

# Shared check helper: runs $OC_MANAGED plugin check, captures the exit code
# without trusting it, retries the recorded context transient once, and
# returns the parsed version through stdout. $1=spec $2=expected version
# ("" at install time) $3=current_only ("1" for post-update rechecks).
opencode_plugin_check_retried() {
  local spec="$1" expected="$2" current_only="$3" attempt check_exit output parsed
  for attempt in 1 2; do
    check_exit=0
    output="$("${OC_MANAGED}" plugin check "${spec}" 2>&1)" || check_exit=$?
    parsed="$(parse_plugin_check "${spec}" "${output}" "${expected}" "${current_only}" "${check_exit}")" || parsed=""
    if [[ -n "${parsed}" ]]; then
      printf '%s\n' "${parsed}"
      return 0
    fi
    if [[ "${attempt}" -lt 2 && (-z "${output}" || "${output}" == *"Plugin is not configured"*) ]]; then
      warn "OpenCode plugin check ${spec} reported a transient context error; retrying once"
      sleep 1
      continue
    fi
    warn "OpenCode plugin check ${spec} parser failed: ${output}"
    return 1
  done
  return 1
}

PLUGIN_RESOLVED_VERSIONS=()
for plugin in "${PLUGINS[@]}" "${CLI_PLUGIN_SPECS[@]}"; do
  # The check command can exit nonzero while still printing a parseable
  # status table (recorded: voice's upstream headless-context check
  # failure). Capture regardless of exit code and let the parser's
  # exactly-one-match + tolerance + status rules decide; a crashed check
  # with empty output still fails closed here.
  if resolved_version="$(opencode_plugin_check_retried "${plugin}" "" 0)"; then
    PLUGIN_RESOLVED_VERSIONS+=("${plugin}=${resolved_version}")
    info "OpenCode plugin check ${plugin}: resolved=${resolved_version}"
  else
    PLUGIN_INSTALL_FAILED=1
  fi
done
if [[ "${PLUGIN_INSTALL_FAILED}" -ne 0 ]]; then
  die "One or more OpenCode plugin version checks failed"
fi

if [[ "${DOTFILES_RUN_OPENCODE_PLUGIN_UPDATE:-0}" == "1" ]]; then
  PLUGIN_UPDATE_FAILED=0
  for plugin in "${PLUGINS[@]}" "${CLI_PLUGIN_SPECS[@]}"; do
    if output="$("${OC_MANAGED}" plugin update "${plugin}" 2>&1)"; then
      info "OpenCode plugin update ${plugin}: ${output}"
      expected_version=""
      for resolved in "${PLUGIN_RESOLVED_VERSIONS[@]}"; do
        if [[ "${resolved%%=*}" == "${plugin}" ]]; then
          expected_version="${resolved#*=}"
          break
        fi
      done
      # Same tolerated-exit handling as the install-time check above: parse
      # the recheck output regardless of the check exit code. current_only=1
      # keeps the recheck strict: a refreshed plugin must report (current).
      if resolved_version="$(opencode_plugin_check_retried "${plugin}" "" 1)"; then
        info "OpenCode plugin recheck ${plugin}: previous=${expected_version}; resolved=${resolved_version}"
      else
        warn "OpenCode plugin ${plugin} recheck parser failed"
        PLUGIN_UPDATE_FAILED=1
      fi
    else
      warn "OpenCode plugin update ${plugin} failed: ${output}"
      PLUGIN_UPDATE_FAILED=1
    fi
  done
  if [[ "${PLUGIN_UPDATE_FAILED}" -ne 0 ]]; then
    die "One or more OpenCode plugin updates failed"
  fi
fi

# The meridian plugin is installed globally via npm and referenced by local path.
# No opencode plugin install needed — it's already at its nvm global path.
MERIDIAN_PATH="$(PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 -m meridian_path 2>/dev/null || true)"
if [[ -f "${MERIDIAN_PATH}" ]]; then
  ok "opencode plugin: meridian (already installed globally via npm)"
else
  warn "opencode plugin: meridian not found at ${MERIDIAN_PATH} — install @rynfar/meridian globally with npm"
fi

# ---------------------------------------------------------------------------
# Voice dependencies (whisper.cpp, sox, piper-tts) + models
#   Controlled by DOTFILES_RUN_VOICE_SETUP (default: 0 — skip)
#   Models: DOTFILES_WHISPER_MODEL (default: ggml-large-v3-turbo.bin)
#          DOTFILES_PIPER_VOICE (default: en_US-lessac-high)
# ---------------------------------------------------------------------------
VOICE_SETUP="${DOTFILES_RUN_VOICE_SETUP:-0}"
if [[ "$VOICE_SETUP" != "1" ]]; then
  info "DOTFILES_RUN_VOICE_SETUP='${VOICE_SETUP}' — skipping voice deps & models"
  info "  Set DOTFILES_RUN_VOICE_SETUP=1 to install whisper.cpp, sox, piper-tts, and models"
else
  info "Installing voice dependencies..."

  # ── whisper.cpp + sox (STT) ──────────────────────────────────────
  if command -v brew &>/dev/null; then
    for pkg in whisper.cpp sox; do
      if brew list "$pkg" &>/dev/null 2>&1; then
        ok "$pkg already installed"
      else
        if brew install "$pkg" 2>/dev/null; then
          ok "$pkg installed"
        else
          warn "$pkg install failed — install manually: brew install $pkg"
        fi
      fi
    done
  else
    warn "brew not found; skipping whisper.cpp/sox install"
  fi

  # ── Piper TTS ─────────────────────────────────────────────────────
  if command -v uv &>/dev/null; then
    if uv tool list 2>/dev/null | grep -q "piper-tts"; then
      ok "piper-tts already installed via uv"
    else
      if uv tool install piper-tts 2>/dev/null; then
        ok "piper-tts installed via uv"
      else
        warn "piper-tts install failed — install manually: uv tool install piper-tts"
      fi
    fi
  elif command -v pip &>/dev/null; then
    if pip show piper-tts &>/dev/null 2>&1; then
      ok "piper-tts already installed via pip"
    else
      if pip install piper-tts 2>/dev/null; then
        ok "piper-tts installed via pip"
      else
        warn "piper-tts install failed — install manually: pip install piper-tts"
      fi
    fi
  else
    warn "Neither uv nor pip found; skipping piper-tts install"
  fi

  # ── Download Whisper model ─────────────────────────────────────────
  WHISPER_MODEL="${DOTFILES_WHISPER_MODEL:-ggml-large-v3-turbo.bin}"
  WHISPER_DIR="$HOME/.local/share/whisper-cpp"
  WHISPER_PATH="$WHISPER_DIR/$WHISPER_MODEL"

  if [[ -f "$WHISPER_PATH" ]]; then
    ok "Whisper model already exists: $WHISPER_MODEL"
  else
    info "Downloading Whisper model: $WHISPER_MODEL..."
    mkdir -p "$WHISPER_DIR"
    WHISPER_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$WHISPER_MODEL"
    if curl -L --fail --progress-bar -o "$WHISPER_PATH" "$WHISPER_URL" 2>/dev/null; then
      ok "Whisper model downloaded: $WHISPER_MODEL"
    else
      rm -f "$WHISPER_PATH"
      warn "Whisper model download failed — download manually from:"
      warn "  $WHISPER_URL"
      warn "  Save to: $WHISPER_PATH"
    fi
  fi

  # ── Download Piper voice ───────────────────────────────────────────
  PIPER_VOICE="${DOTFILES_PIPER_VOICE:-en_US-lessac-high}"
  PIPER_DIR="$HOME/.local/share/piper-voices"
  VOICE_LOCALE="$(echo "$PIPER_VOICE" | cut -d- -f1)"
  VOICE_NAME="$(echo "$PIPER_VOICE" | cut -d- -f2)"
  VOICE_QUALITY="$(echo "$PIPER_VOICE" | cut -d- -f3)"
  VOICE_LANG="$(echo "$VOICE_LOCALE" | cut -d_ -f1)"
  VOICE_URL_PATH="${VOICE_LANG}/${VOICE_LOCALE}/${VOICE_NAME}/${VOICE_QUALITY}"
  PIPER_ONNX="$PIPER_DIR/$PIPER_VOICE.onnx"
  PIPER_JSON="$PIPER_DIR/$PIPER_VOICE.onnx.json"
  PIPER_BASE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main"

  PIPER_DOWNLOAD_NEEDED=0
  if [[ ! -f "$PIPER_ONNX" ]]; then
    PIPER_DOWNLOAD_NEEDED=1
  fi
  if [[ ! -f "$PIPER_JSON" ]]; then
    PIPER_DOWNLOAD_NEEDED=1
  fi

  if [[ "$PIPER_DOWNLOAD_NEEDED" -eq 0 ]]; then
    ok "Piper voice already exists: $PIPER_VOICE"
  else
    info "Downloading Piper voice: $PIPER_VOICE..."
    mkdir -p "$PIPER_DIR"
    DL_FAILED=0

    if [[ ! -f "$PIPER_ONNX" ]]; then
      ONNX_URL="$PIPER_BASE_URL/$VOICE_URL_PATH/$PIPER_VOICE.onnx"
      if curl -L --fail --progress-bar -o "$PIPER_ONNX" "$ONNX_URL" 2>/dev/null; then
        ok "Piper voice .onnx downloaded"
      else
        rm -f "$PIPER_ONNX"
        warn "Piper voice .onnx download failed — download manually from:"
        warn "  $ONNX_URL"
        warn "  Save to: $PIPER_ONNX"
        DL_FAILED=1
      fi
    fi

    if [[ ! -f "$PIPER_JSON" ]]; then
      JSON_URL="$PIPER_BASE_URL/$VOICE_URL_PATH/$PIPER_VOICE.onnx.json"
      if curl -L --fail --progress-bar -o "$PIPER_JSON" "$JSON_URL" 2>/dev/null; then
        ok "Piper voice .onnx.json downloaded"
      else
        rm -f "$PIPER_JSON"
        warn "Piper voice .onnx.json download failed — download manually from:"
        warn "  $JSON_URL"
        warn "  Save to: $PIPER_JSON"
        DL_FAILED=1
      fi
    fi

    if [[ "$DL_FAILED" -eq 0 ]]; then
      ok "Piper voice setup complete: $PIPER_VOICE"
    fi
  fi
fi

ok "opencode plugins: done."
