#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Load env before gate (DOTFILES_RUN_OPENCODE_TOOLS_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_OPENCODE_TOOLS_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OPENCODE_TOOLS_SETUP='${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}' — skipping opencode plugin setup"
  exit 0
fi

if ! command -v opencode >/dev/null 2>&1; then
  die "opencode not found; cannot configure pinned plugins."
fi

# Pinned plugin definitions matching ~/.config/opencode/opencode.json.
PLUGINS=(
  "oh-my-opencode-slim@2.2.24"
  "@tarquinen/opencode-dcp@3.2.0"
  "@plannotator/opencode@0.27.18"
  "opencode-planning-with-files@1.0.1"
  "@slkiser/opencode-quota@4.10.2"
)

info "OpenCode found at $(command -v opencode). Plugins are config-registered and will auto-install on OpenCode startup: ${PLUGINS[*]}"
ok "opencode plugins: config registration verified."
