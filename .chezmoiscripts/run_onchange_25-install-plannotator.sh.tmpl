#!/usr/bin/env bash
set -euo pipefail

# dot_config/plannotator/config.json.tmpl: {{ include "dot_config/plannotator/config.json.tmpl" | sha256sum }}
# scripts/install-plannotator.sh: {{ include "scripts/install-plannotator.sh" | sha256sum }}

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
# shellcheck disable=SC1091
source "${LIB_DIR}/common.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/env.sh"

load_env || warn "\$HOME/.env not found, skipping env load"

{{- if eq .chezmoi.os "darwin" }}

if [[ "${DOTFILES_RUN_PLANNOTATOR_PASTE_SETUP:-${DOTFILES_RUN_CADDY_SETUP:-0}}" != "1" ]]; then
  info "DOTFILES_RUN_PLANNOTATOR_PASTE_SETUP='${DOTFILES_RUN_PLANNOTATOR_PASTE_SETUP:-${DOTFILES_RUN_CADDY_SETUP:-0}}' — skipping Plannotator paste setup"
  exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
  die "Homebrew not found; install Homebrew first"
fi

INSTALL_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/install-plannotator.sh"
PLIST_DIR="$HOME/Library/LaunchAgents"
PLIST_PATH="$PLIST_DIR/com.plannotator.paste.plist"
PLANNOTATOR_BIN="$(brew --prefix)/bin/plannotator-paste"
CONFIG_PATH="$HOME/.config/plannotator/config.json"

info "Running Plannotator installer..."
bash "$INSTALL_SCRIPT"

info "Installing Plannotator paste LaunchAgent..."
mkdir -p "$PLIST_DIR"

cat >"$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plannotator.paste</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PLANNOTATOR_BIN}</string>
    <string>--config</string>
    <string>${CONFIG_PATH}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/com.plannotator.paste.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.plannotator.paste.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ env "PATH" }}</string>
  </dict>
</dict>
</plist>
EOF

if launchctl print "gui/$UID/com.plannotator.paste" >/dev/null 2>&1; then
  info "Reloading com.plannotator.paste..."
  launchctl unload -w "$PLIST_PATH" || warn "Failed to unload com.plannotator.paste"
fi

if launchctl load -w "$PLIST_PATH"; then
  ok "com.plannotator.paste loaded"
else
  warn "Failed to load com.plannotator.paste"
fi

ok "Plannotator paste LaunchAgent setup complete"
{{- else if eq .chezmoi.os "linux" }}

# Plannotator paste binary is installed by scripts/install-plannotator.sh (cross-platform)
# Here we create the systemd user service.
if ! command -v plannotator-paste >/dev/null 2>&1; then
  warn "plannotator-paste not found — run install-plannotator.sh first"
  exit 0
fi

SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
SERVICE_PATH="$SYSTEMD_USER_DIR/plannotator-paste.service"
PLANNOTATOR_BIN="$(command -v plannotator-paste)"
CONFIG_PATH="$HOME/.config/plannotator/config.json"
DATA_DIR="${PASTE_DATA_DIR:-$HOME/.plannotator/pastes}"

info "Installing Plannotator paste systemd user service..."
mkdir -p "$SYSTEMD_USER_DIR"
mkdir -p "$DATA_DIR"
cat >"$SERVICE_PATH" <<EOF
[Unit]
Description=Plannotator paste backend

[Service]
Type=simple
ExecStart=${PLANNOTATOR_BIN} --config ${CONFIG_PATH}
Restart=always
RestartSec=5
Environment=HOME=${HOME}

[Install]
WantedBy=default.target
EOF
ok "Plannotator systemd service written to ${SERVICE_PATH}"
systemctl --user daemon-reload || warn "Failed to daemon-reload"
systemctl --user enable --now plannotator-paste.service && ok "plannotator-paste.service enabled and started" || warn "Failed to enable/start plannotator-paste.service"
ok "Plannotator paste systemd setup complete"
{{- else if eq .chezmoi.os "windows" }}

# Plannotator paste binary is installed by scripts/install-plannotator.sh (cross-platform)
# Windows: create a startup shortcut instead of a service.
if ! command -v plannotator-paste >/dev/null 2>&1 && ! command -v plannotator-paste.exe >/dev/null 2>&1; then
  warn "plannotator-paste not found — run install-plannotator.sh first"
  exit 0
fi
info "Plannotator paste on Windows: manual service setup required."
info "Run plannotator-paste --config \"$HOME/.config/plannotator/config.json\" at startup."
ok "Plannotator paste Windows setup note printed."
{{- else }}
info "Skipping Plannotator paste LaunchAgent on {{ .chezmoi.os }}"
{{- end }}
