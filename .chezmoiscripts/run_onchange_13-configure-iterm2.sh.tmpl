#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"

# Script hash triggers (re-run when iTerm2 profile changes):
# configs/iterm2/Default.json.tmpl: {{ include "configs/iterm2/Default.json.tmpl" | sha256sum }}

source_dir="{{ .chezmoi.sourceDir }}"
target_dir="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
target_file="$target_dir/Default.json"
template_file="$source_dir/configs/iterm2/Default.json.tmpl"

info "Configuring iTerm2 dynamic profile..."
mkdir -p "$target_dir"

# Remove stale symlink if present (older setups symlinked to configs/iterm2/Default.json,
# which no longer exists — only the .tmpl does. `>` follows symlinks and would write through
# the broken link instead of creating a fresh file).
if [[ -L "$target_file" ]]; then
  warn "Removing stale symlink at $target_file"
  rm -f "$target_file"
fi

# Render the chezmoi template and write to DynamicProfiles
# Using chezmoi execute-template to resolve the output expression in the template
cat "$template_file" | chezmoi execute-template >"$target_file"

# Validate the rendered JSON: iTerm2's ProfileModel.m calls isEqualToString: on
# several fields that must be JSON strings, not booleans. A boolean in any of
# these fields causes an EXC_BREAKPOINT crash on launch (unreported iTerm2 bug).
# See configs/iterm2/Default.json.tmpl history for the original incident.
python3 - "$target_file" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f:
  data = json.load(f)
# Keys iTerm2 treats as strings — a boolean here crashes on load.
string_keys = {
  "Custom Command", "Command", "Name", "Guid", "Terminal Type",
  "Custom Directory", "Description", "Shortcut", "Working Directory",
  "Normal Font", "Non Ascii Font",
}
errors = []
for profile in data.get("Profiles", []):
  for key, value in profile.items():
    if key in string_keys and isinstance(value, bool):
      errors.append(f"  {key}: {value!r} (boolean, expected string)")
if errors:
  print(f"ERROR: {path} has string-typed fields set as booleans (iTerm2 crash risk):", file=sys.stderr)
  for e in errors:
    print(e, file=sys.stderr)
  sys.exit(1)
PYEOF

# Set this dynamic profile as the iTerm2 default profile.
# Dynamic profiles cannot self-declare as default in their JSON, so we set the
# `Default Bookmark Guid` preference to match our profile's Guid.
# `defaults` coordinates with cfprefsd, so no manual killall is needed.
profile_guid="dotfiles-default-profile-v1"
current_default="$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null || true)"
if [[ "$current_default" != "$profile_guid" ]]; then
  info "Setting iTerm2 default profile to Guid: $profile_guid"
  defaults write com.googlecode.iterm2 "Default Bookmark Guid" -string "$profile_guid"
else
  info "iTerm2 default profile already set to $profile_guid"
fi

ok "iTerm2 dynamic profile configured (non-rewritable, tmux command, default)."
