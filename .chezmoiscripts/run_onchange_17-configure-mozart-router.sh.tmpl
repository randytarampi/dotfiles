#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Script hash triggers (re-run when Mozart routing changes):
# configs/mozart-router/mozart.json: {{ include "configs/mozart-router/mozart.json" | sha256sum }}
# scripts/configure-mozart-router.py: {{ include "scripts/configure-mozart-router.py" | sha256sum }}

load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_MOZART_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_MOZART_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_MOZART_SETUP='${DOTFILES_RUN_MOZART_SETUP:-0}' — skipping mozart-router configuration"
  exit 0
fi

# configure-mozart-router.py is the sole writer of ~/.mozart/mozart.json.
CONFIGURE_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/configure-mozart-router.py"
if [[ -f "$CONFIGURE_SCRIPT" ]]; then
  "$CONFIGURE_SCRIPT"
else
  warn "configure-mozart-router.py not found at $CONFIGURE_SCRIPT"
fi
