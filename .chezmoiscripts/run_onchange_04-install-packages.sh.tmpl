  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.legacy.vmware")
  {{- end }}
  {{- if and .categories.desktop_privacy (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.privacy")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.privacy")
  {{- end }}
  {{- if and .categories.desktop_emulation (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.emulation")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.emulation")
  {{- end }}
  {{- if and .categories.desktop_gaming_emulation (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.gaming.emulation")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.gaming.emulation")
  {{- end }}
  {{- if and .categories.desktop_productivity_msoffice (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.productivity.msoffice")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.productivity.msoffice")
  {{- end }}
  {{- if and .categories.desktop_productivity_adobe (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.productivity.adobe")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.productivity.adobe")
  {{- end }}

  # Fail *before* acquiring Homebrew or changing any packages when a selected
  # Linux category contains macOS casks or invalid Brewfile syntax. Unknown
  # formula/tap support remains unqualified until actual host receipts.
  if [[ "$(uname -s)" == "Linux" ]]; then
    linux_audit_args=()
    for selected_manifest in "${selected_brewfiles[@]}"; do
      linux_audit_args+=(--manifest "$selected_manifest")
    done
    if [[ -n "${DOTFILES_BREWFILE_IGNORE:-}" ]]; then
      IFS=',' read -r -a linux_ignored_names <<<"${DOTFILES_BREWFILE_IGNORE}"
      for linux_ignored_name in "${linux_ignored_names[@]}"; do
        linux_ignored_name="${linux_ignored_name// /}"
        if [[ -n "$linux_ignored_name" ]]; then
          linux_audit_args+=(--ignore "$linux_ignored_name")
        fi
      done
    fi
    if ! python3 "{{ .chezmoi.sourceDir }}/scripts/check-linux-brewfile-eligibility.py" --enforce "${linux_audit_args[@]}"; then
      die "Linux package selection was refused before any Homebrew operation (see the audit output above); no package manager was invoked"
    fi
  fi

  # Resolve *after* installation; a missing brew --prefix must not become
  # /bin/brew. Stop on failed download/install/shellenv before any bundle.
  source "${LIB_DIR}/homebrew_bootstrap.sh"
  dotfiles_homebrew_ready || die "Homebrew prerequisite unavailable; refusing package reconciliation"

  # Trust only the taps the selected manifests declare. `brew trust` writes
  # persistent user state (~/.homebrew/trust.json or
  # $XDG_CONFIG_HOME/homebrew/trust.json), so an unselected manifest must never
  # reach it, and a trust failure for a selected tap must not be hidden.
  selected_taps=()
  for selected_manifest in "${selected_brewfiles[@]}"; do
    if [[ -f "$selected_manifest" ]]; then
      while IFS= read -r tap_name; do
        if [[ -n "$tap_name" ]]; then
          selected_taps+=("$tap_name")
        fi
      done < <(sed -nE 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/p' "$selected_manifest")
    fi
  done
  if [[ "${#selected_taps[@]}" -gt 0 ]]; then
    if brew trust --help >/dev/null 2>&1; then
      while IFS= read -r tap_name; do
        if [[ -n "$tap_name" ]] && ! brew trust "$tap_name"; then
          die "brew trust failed for selected tap: $tap_name"
        fi
      done < <(printf '%s\n' "${selected_taps[@]}" | sort -u)
    elif [[ "$(uname -s)" == "Linux" ]]; then
      die "This Homebrew has no 'brew trust' but selected manifests declare third-party taps; refusing to bundle untrusted taps"
    else
      warn "This Homebrew has no 'brew trust'; selected third-party taps will be bundled without an explicit trust step"
    fi
  fi

  # Microsoft SQL Server formulae prompt for a licence. macOS keeps the
  # established non-interactive default; Linux must not accept a licence the
  # operator did not supply, and no licensed package is selected there.
  if [[ "$(uname -s)" == "Darwin" ]]; then
    export HOMEBREW_ACCEPT_EULA="${HOMEBREW_ACCEPT_EULA:-Y}"
  fi

  {{- if .categories.local_ai_headless }}
  # Refuse macOS app/formula dual ownership before running any brew bundle.
  source "${LIB_DIR}/ollama_brew_preflight.sh"
  ollama_brew_package_preflight "{{ .categories.desktop_dev }}" ||
    die "Headless Ollama package preflight failed; no bundles run"
  {{- end }}

  # Filter ignored packages from a Brewfile before running brew bundle.
  # Controlled by DOTFILES_BREWFILE_IGNORE: exact brew/cask names, matched
  # literally by scripts/filter-brewfile.py. Operator input is never compiled
  # into a pattern and never reaches the shell as code.
  brew_bundle_filtered() {
    local file="$1"
    local status
    if [[ -z "${DOTFILES_BREWFILE_IGNORE:-}" ]]; then
      brew bundle --file="$file"
      return
    fi
    local filtered
    filtered="$(
      umask 077
      mktemp
    )"
    if ! python3 "{{ .chezmoi.sourceDir }}/scripts/filter-brewfile.py" \
      --manifest "$file" \
      --out "$filtered" \
      --ignore-list "${DOTFILES_BREWFILE_IGNORE}" \
      --force; then
      rm -f "$filtered"
      die "Failed to apply DOTFILES_BREWFILE_IGNORE to $file"
    fi
    if brew bundle --file="$filtered"; then
      rm -f "$filtered"
      return 0
    else
      status=$?
      rm -f "$filtered"
      return "$status"
    fi
  }

  # Bundles run in the selected order; the npm companion lane follows for the
  # manifests that declare npm entries.
  for selected_manifest in "${selected_brewfiles[@]}"; do
    brew_bundle_filtered "$selected_manifest"
  done
  for selected_manifest in "${selected_npm_manifests[@]}"; do
    bash "{{ .chezmoi.sourceDir }}/scripts/install-npm-brewfile-packages.sh" "$selected_manifest" ||
      warn "npm package reconciliation failed for $(basename "$selected_manifest")"
  done

fi

# --- Cross-platform fonts (Linux + Windows; macOS handled by brew bundle above) ---
{{- if .categories.desktop_fonts }}
{{- if eq .chezmoi.os "linux" }}
if command -v bash &>/dev/null; then
  bash "{{ .chezmoi.sourceDir }}/scripts/install-fonts.sh" linux || warn "Font installation completed with warnings"
fi
{{- else if eq .chezmoi.os "windows" }}
bash "{{ .chezmoi.sourceDir }}/scripts/install-fonts.sh" windows || warn "Font installation completed with warnings"
{{- end }}
{{- end }}

