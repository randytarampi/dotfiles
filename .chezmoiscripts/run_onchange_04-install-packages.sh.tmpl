    {{- end }}

    {{- if .categories.desktop_comms }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.comms"
    {{- end }}

    {{- if .categories.desktop_security }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.security"
    {{- end }}

    {{- if .categories.desktop_media }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.media"
    {{- end }}

    {{- if .categories.desktop_utilities }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.utilities"
    {{- end }}

    {{- if .categories.desktop_devices }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.devices"
    {{- end }}

    {{- if .categories.desktop_macos }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.macos"
    {{- end }}

    {{- if and .categories.desktop_gaming }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.gaming"
    {{- end }}

    {{- if .categories.desktop_fonts }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.fonts"
    {{- end }}

    {{- if .categories.desktop_cloud }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.cloud"
    {{- end }}

    {{- if .categories.desktop_productivity }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.desktop.productivity"
    {{- end }}

    {{- if .categories.dev_ops }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.dev.ops"
    {{- end }}

    {{- if .categories.legacy }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.legacy"
    {{- end }}

    {{- if .categories.legacy_macfuse }}
