# --- Brew (macOS / Linux) ---
if [[ "$(uname -s)" == "Darwin" ]] || [[ "$(uname -s)" == "Linux" ]]; then
    BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
    BREW_BIN="${BREW_PREFIX}/bin/brew"

    if ! command -v brew &>/dev/null; then
        if [[ -x "${BREW_BIN}" ]]; then
            eval "$("${BREW_BIN}" shellenv)"
        else
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            eval "$("${BREW_BIN}" shellenv)"
        fi
    fi

    # Trust third-party taps before running brew bundle
    for tap_name in $(grep -h '^tap "' "{{ .chezmoi.sourceDir }}"/Brewfile* 2>/dev/null | sed 's/^tap "//;s/"$//'); do
        brew trust "$tap_name" 2>/dev/null || true
    done

    # Accept EULA for Microsoft SQL Server formulas (msodbcsql18, mssql-tools18)
    # to avoid interactive prompt hanging brew bundle in non-interactive mode.
    export HOMEBREW_ACCEPT_EULA="${HOMEBREW_ACCEPT_EULA:-Y}"

    # Filter ignored packages from a Brewfile before running brew bundle.
    # Controlled by DOTFILES_BREWFILE_IGNORE (comma-separated brew/cask names).
    brew_bundle_filtered() {
        local file="$1"
        if [[ -n "${DOTFILES_BREWFILE_IGNORE:-}" ]]; then
            local tmpfile
            tmpfile="$(mktemp)"
            # Build grep pattern: skip lines matching any ignored name
            local pattern
            pattern="$(echo "$DOTFILES_BREWFILE_IGNORE" | tr ',' '|' | sed 's/|/\\|/g')"
            grep -vE "(brew|cask) \"($pattern)\"" "$file" > "$tmpfile"
            brew bundle --file="$tmpfile"
            local rc=$?
            rm -f "$tmpfile"
            return $rc
        else
            brew bundle --file="$file"
        fi
    }

    # dev.cli — always installed
    brew_bundle_filtered {{ .chezmoi.sourceDir }}/Brewfile
    bash "{{ .chezmoi.sourceDir }}/scripts/install-npm-brewfile-packages.sh" "{{ .chezmoi.sourceDir }}/Brewfile" || warn "npm package reconciliation failed for Brewfile"

    {{- if .categories.dev }}
    brew_bundle_filtered {{ .chezmoi.sourceDir }}/Brewfile.dev
    bash "{{ .chezmoi.sourceDir }}/scripts/install-npm-brewfile-packages.sh" "{{ .chezmoi.sourceDir }}/Brewfile.dev" || warn "npm package reconciliation failed for Brewfile.dev"
    {{- end }}

    {{- if .categories.dev_security }}
