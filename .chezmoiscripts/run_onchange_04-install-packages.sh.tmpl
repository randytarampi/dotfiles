# --- Brew (macOS / Linux) ---
if [[ "$(uname -s)" == "Darwin" ]] || [[ "$(uname -s)" == "Linux" ]]; then
  # One ordered selected-manifest set. The Linux preflight, the tap-trust
  # step and the actual bundles all consume this exact list, so a category
  # cannot be selected for one consumer and missed by another. The npm
  # companion lane is tracked separately; it is a different package manager.
  selected_brewfiles=("{{ .chezmoi.sourceDir }}/Brewfile")
  selected_npm_manifests=("{{ .chezmoi.sourceDir }}/Brewfile")
  {{- if .categories.dev }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.dev")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.dev")
  {{- end }}
  {{- if .categories.local_ai_headless }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.local.ai.headless")
  {{- end }}
  {{- if .categories.dev_security }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.dev.security")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.dev.security")
  {{- end }}
  {{- if .categories.utilities }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.utilities")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.utilities")
  {{- end }}
  {{- if and .categories.desktop_browsers (eq .chezmoi.os "darwin") }}
  selected_brewfiles+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.browsers")
  selected_npm_manifests+=("{{ .chezmoi.sourceDir }}/Brewfile.desktop.browsers")
