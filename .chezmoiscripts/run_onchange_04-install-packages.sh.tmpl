# --- Cross-platform fonts (Linux + Windows; macOS handled by brew bundle above) ---
{{- if .categories.desktop_fonts }}
{{- if eq .chezmoi.os "linux" }}
if command -v bash &>/dev/null; then
    bash "{{ .chezmoi.sourceDir }}/scripts/install-fonts.sh" linux || warn "Font installation completed with warnings"
fi
{{- else if eq .chezmoi.os "windows" }}
bash "{{ .chezmoi.sourceDir }}/scripts/install-fonts.sh" windows || warn "Font installation completed with warnings"
{{- end }}
{{- end }}

# --- Winget (Windows) ---
{{- if eq .chezmoi.os "windows" }}
WINGET_BUNDLE="{{ .chezmoi.sourceDir }}/wingetfile"

if ! command -v winget &>/dev/null; then
    warn "winget not found; skipping Windows package installs"
else
    info "Installing winget packages..."

    # Filter ignored packages from a wingetfile before running winget import.
    # Controlled by DOTFILES_WINGETFILE_IGNORE (comma-separated Package IDs).
    winget_import_filtered() {
        local file="$1"
        if [[ -n "${DOTFILES_WINGETFILE_IGNORE:-}" ]]; then
            local tmpfile
            tmpfile="$(mktemp)"
            local pattern
            pattern="$(echo "$DOTFILES_WINGETFILE_IGNORE" | tr ',' '|' | sed 's/|/\\|/g')"
            grep -vE "^($pattern)$" "$file" > "$tmpfile"
            winget_import_filtered "$tmpfile"
            local rc=$?
            rm -f "$tmpfile"
            return $rc
        else
            winget_import_filtered "$file"
        fi
    }

    # base — always installed
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile"

    {{- if .categories.dev }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.dev"
    {{- end }}

    {{- if .categories.dev_security }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.dev.security"
    {{- end }}

    {{- if .categories.utilities }}
    winget_import_filtered "{{ .chezmoi.sourceDir }}/wingetfile.utilities"
    {{- end }}

    {{- if .categories.desktop_dev }}
