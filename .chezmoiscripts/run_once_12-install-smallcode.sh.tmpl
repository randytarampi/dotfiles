#!/usr/bin/env bash
set -euo pipefail

# ─── run_once_12-install-smallcode.sh.tmpl ──────────────────────────────────
# Installs the smallcode CLI (npm global package).
# Gated on DOTFILES_RUN_SMALLCODE_SETUP=1 in ~/.env.
# ──────────────────────────────────────────────────────────────────────────────

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Load environment for API keys
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_SMALLCODE_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_SMALLCODE_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_SMALLCODE_SETUP='${DOTFILES_RUN_SMALLCODE_SETUP:-0}' — skipping smallcode installation"
  exit 0
fi

INSTALL_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/install-smallcode.sh"
if [[ -f "$INSTALL_SCRIPT" ]]; then
  bash "$INSTALL_SCRIPT"
else
  warn "install-smallcode.sh not found; skipping smallcode installation"
fi
