#!/bin/bash
set -euo pipefail

# scripts/lib/caddy_helpers.sh: {{ include "scripts/lib/caddy_helpers.sh" | sha256sum }}
# scripts/configure-opencode.py: {{ include "scripts/configure-opencode.py" | sha256sum }}

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
# shellcheck disable=SC1091
source "${LIB_DIR}/common.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/env.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/caddy_helpers.sh"

load_env || warn "\$HOME/.env not found, skipping env load"

OS_NAME="{{ .chezmoi.os }}"

if [[ "$OS_NAME" == "darwin" ]]; then
  if [[ "${DOTFILES_RUN_OPENCODE_WEB:-0}" != "1" ]]; then
    info "DOTFILES_RUN_OPENCODE_WEB='${DOTFILES_RUN_OPENCODE_WEB:-0}' — skipping OpenCode web LaunchAgent"
    exit 0
  fi

  if ! command -v opencode >/dev/null 2>&1; then
    warn "opencode CLI not found — skipping OpenCode web LaunchAgent"
    exit 0
  fi

  PLIST_DIR="$(caddy_launch_agents_dir)"
  PLIST_PATH="$PLIST_DIR/com.opencode.web.plist"
  # launchd requires absolute path — bare "opencode" fails with EX_CONFIG (78)
  OPENCODE_BIN="$(command -v opencode)"

  info "Installing OpenCode web LaunchAgent..."
  mkdir -p "$PLIST_DIR"

  cat >"$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opencode.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>${OPENCODE_BIN}</string>
    <string>web</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/com.opencode.web.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.opencode.web.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ env "PATH" }}</string>
  </dict>
</dict>
</plist>
EOF

  LAUNCHCTL_DOMAIN="$(caddy_launchctl_domain)"
  launchctl enable "$LAUNCHCTL_DOMAIN/com.opencode.web" 2>/dev/null || warn "Failed to enable com.opencode.web"
  if launchctl print "$LAUNCHCTL_DOMAIN/com.opencode.web" >/dev/null 2>&1; then
    info "Unloading existing com.opencode.web..."
    launchctl bootout "$LAUNCHCTL_DOMAIN/com.opencode.web" 2>/dev/null || warn "Failed to bootout com.opencode.web"
    sleep 2
  fi
  info "Loading com.opencode.web..."
  BOOTSTRAP_OUTPUT=$(launchctl bootstrap "$LAUNCHCTL_DOMAIN" "$PLIST_PATH" 2>&1) && ok "com.opencode.web loaded" || warn "Failed to bootstrap com.opencode.web: $BOOTSTRAP_OUTPUT"

  ok "OpenCode web LaunchAgent setup complete"
else
  info "Skipping OpenCode web LaunchAgent on ${OS_NAME}"
fi
