#!/bin/bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Load master secrets from ~/.env (must happen before gate)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_OPENCODE_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_OPENCODE_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OPENCODE_SETUP='${DOTFILES_RUN_OPENCODE_SETUP:-0}' — skipping secrets configuration"
  exit 0
fi

info "Configuring secrets and environment for AI tools..."

# Helper: write a .env file idempotently (overwrite if changed, skip if identical)
write_env_file() {
  local target_file="$1"
  local content="$2"
  local target_dir
  target_dir=$(dirname "$target_file")

  mkdir -p "$target_dir"

  if [[ -f "$target_file" ]]; then
    if diff -q <(echo "$content") "$target_file" &>/dev/null; then
      info "Unchanged: $target_file"
      return 0
    fi
  fi

  echo "$content" >"$target_file"
  chmod 600 "$target_file"
  ok "Written: $target_file"
}

# opencode .env
write_env_file "$HOME/.config/opencode/.env" "$(
  cat <<EOF
OPENAI_API_KEY='${OPENAI_API_KEY:-}'
ANTHROPIC_API_KEY='${ANTHROPIC_API_KEY:-}'
GEMINI_API_KEY='${GEMINI_API_KEY:-}'
GH_TOKEN='${GH_TOKEN:-}'
EOF
)"

# ~/.ai/.env (for various AI tools)
write_env_file "$HOME/.ai/.env" "$(
  cat <<EOF
OPENAI_API_KEY='${OPENAI_API_KEY:-}'
ANTHROPIC_API_KEY='${ANTHROPIC_API_KEY:-}'
GH_TOKEN='${GH_TOKEN:-}'
EOF
)"

# ~/.air/.env (for Cursor)
write_env_file "$HOME/.air/.env" "$(
  cat <<EOF
OPENAI_API_KEY='${OPENAI_API_KEY:-}'
ANTHROPIC_API_KEY='${ANTHROPIC_API_KEY:-}'
GH_TOKEN='${GH_TOKEN:-}'
EOF
)"

# ~/.codex/.env (for OpenAI Codex)
write_env_file "$HOME/.codex/.env" "$(
  cat <<EOF
OPENAI_API_KEY='${OPENAI_API_KEY:-}'
GH_TOKEN='${GH_TOKEN:-}'
EOF
)"

# ~/.cursor/.env (for Cursor agent)
write_env_file "$HOME/.cursor/.env" "$(
  cat <<EOF
OPENAI_API_KEY='${OPENAI_API_KEY:-}'
ANTHROPIC_API_KEY='${ANTHROPIC_API_KEY:-}'
GH_TOKEN='${GH_TOKEN:-}'
EOF
)"

# ~/.gemini/.env (for Gemini)
write_env_file "$HOME/.gemini/.env" "$(
  cat <<EOF
GEMINI_API_KEY='${GEMINI_API_KEY:-}'
EOF
)"

ok "Secrets and environment configured for all AI tools."
