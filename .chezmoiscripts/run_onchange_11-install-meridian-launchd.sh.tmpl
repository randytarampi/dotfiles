#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Load env before gate (DOTFILES_RUN_MERIDIAN_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_MERIDIAN_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_MERIDIAN_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_MERIDIAN_SETUP='${DOTFILES_RUN_MERIDIAN_SETUP:-0}' — skipping Meridian setup"
  exit 0
fi

{{- if eq .chezmoi.os "darwin" }}

LAUNCH_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/meridian-launch.sh"
PLIST_DIR="$HOME/Library/LaunchAgents"
PLIST_PATH="$PLIST_DIR/com.meridian.proxy.plist"

info "Installing Meridian launchd plist..."
mkdir -p "$PLIST_DIR"

cat >"$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.meridian.proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>${LAUNCH_SCRIPT}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.meridian.proxy.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.meridian.proxy.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ env "PATH" }}</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/tmp</string>
</dict>
</plist>
EOF
ok "Meridian launchd plist written to ${PLIST_PATH}."

LAUNCHCTL_DOMAIN="gui/$(id -u)"
if launchctl print "$LAUNCHCTL_DOMAIN/com.meridian.proxy" >/dev/null 2>&1; then
  info "Reloading com.meridian.proxy..."
  launchctl bootout "$LAUNCHCTL_DOMAIN/com.meridian.proxy" 2>/dev/null || warn "Failed to bootout com.meridian.proxy"
  sleep 2
else
  info "Loading com.meridian.proxy..."
fi
BOOTSTRAP_OUTPUT=$(launchctl bootstrap "$LAUNCHCTL_DOMAIN" "$PLIST_PATH" 2>&1) && ok "com.meridian.proxy loaded." || warn "Failed to bootstrap com.meridian.proxy: $BOOTSTRAP_OUTPUT"

ok "Meridian launchd setup complete."
{{- else if eq .chezmoi.os "linux" }}

# Gate check is above, env is loaded.
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
SERVICE_PATH="$SYSTEMD_USER_DIR/meridian-proxy.service"
LAUNCH_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/meridian-launch.sh"

info "Installing Meridian systemd user service..."
mkdir -p "$SYSTEMD_USER_DIR"

cat >"$SERVICE_PATH" <<EOF
[Unit]
Description=Meridian proxy
After=network.target

[Service]
Type=simple
ExecStart=${LAUNCH_SCRIPT}
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin:${HOME}/.local/bin

[Install]
WantedBy=default.target
EOF
ok "Meridian systemd service written to ${SERVICE_PATH}"

systemctl --user daemon-reload || warn "Failed to daemon-reload"
systemctl --user enable --now meridian-proxy.service && ok "meridian-proxy.service enabled and started" || warn "Failed to enable/start meridian-proxy.service"

ok "Meridian systemd setup complete."
{{- else }}
info "Skipping Meridian launchd setup on {{ .chezmoi.os }}"
{{- end }}
