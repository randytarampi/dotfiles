#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Script hash triggers (re-run when CodeGraph config changes):
# configs/mcp/codegraph.json: {{ include "configs/mcp/codegraph.json" | sha256sum }}
# scripts/configure-codegraph.py: {{ include "scripts/configure-codegraph.py" | sha256sum }}

# Load env before gate (DOTFILES_RUN_CODEGRAPH_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_CODEGRAPH_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_CODEGRAPH_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_CODEGRAPH_SETUP='${DOTFILES_RUN_CODEGRAPH_SETUP:-0}' — skipping CodeGraph MCP setup"
  exit 0
fi

info "Configuring CodeGraph MCP..."

if ! command -v codegraph >/dev/null 2>&1; then
  warn "codegraph CLI not found; skipping CodeGraph MCP setup"
  exit 0
fi

if codegraph install -y --target auto --location global >/dev/null 2>&1; then
  ok "CodeGraph MCP configured for detected agents"
else
  warn "codegraph install failed — you can run 'codegraph install' manually"
fi

# Batch-initialize per-project .codegraph/ indexes (separate gate from MCP registration)
if [[ "${DOTFILES_RUN_CODEGRAPH_INDEX_SETUP:-0}" == "1" ]]; then
  info "Batch-indexing CodeGraph for git repos..."
  if command -v codegraph >/dev/null 2>&1; then
    python3 "{{ .chezmoi.sourceDir }}/scripts/configure-codegraph.py" || warn "CodeGraph batch indexing failed"
  else
    warn "codegraph CLI not found; skipping batch indexing"
  fi
else
  info "DOTFILES_RUN_CODEGRAPH_INDEX_SETUP='${DOTFILES_RUN_CODEGRAPH_INDEX_SETUP:-0}' — skipping CodeGraph batch indexing"
fi
