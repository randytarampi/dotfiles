#!/usr/bin/env bash
set -euo pipefail
# env gate fingerprint: {{ env "DOTFILES_RUN_CADDY_SETUP" | sha256sum }}
# env gate fingerprint: {{ env "DOTFILES_LITELLM_UI_EXPOSED" | default "0" | sha256sum }}
# env gate fingerprint: {{ env "DOTFILES_RUN_PASEO_WEB_SETUP" | default "0" | sha256sum }}:{{ env "CADDY_ACCESS" | default "localhost" | sha256sum }}

# configs/caddy/Caddyfile.tmpl: {{ include "configs/caddy/Caddyfile.tmpl" | sha256sum }}
# scripts/configure-caddy.py: {{ include "scripts/configure-caddy.py" | sha256sum }}
# scripts/lib/caddy_domains.py: {{ include "scripts/lib/caddy_domains.py" | sha256sum }}
# scripts/lib/paseo_web_policy.py: {{ include "scripts/lib/paseo_web_policy.py" | sha256sum }}
# scripts/lib/caddy_helpers.sh: {{ include "scripts/lib/caddy_helpers.sh" | sha256sum }}
# scripts/migrate-acme-ddns.sh: {{ include "scripts/migrate-acme-ddns.sh" | sha256sum }}
# env fingerprint: {{ env "DOTFILES_RUN_OPENWEBUI_SETUP" | default "0" }}:{{ env "DOTFILES_OPENWEBUI_VERSION" | default "0.13.4" }}:{{ env "OPENWEBUI_PORT" | default "8080" }}
# secret presence fingerprint: {{ if env "WEBUI_SECRET_KEY" }}set{{ else }}unset{{ end }}:{{ if env "WEBUI_ADMIN_PASSWORD" }}set{{ else }}unset{{ end }}:{{ if env "OPENWEBUI_API_KEY" }}set{{ else }}unset{{ end }}

{{- if eq .chezmoi.os "darwin" }}
BREW_BIN="${BREW_BIN:-$(command -v brew 2>/dev/null || true)}"
export BREW_BIN
if [[ -z "$BREW_BIN" ]]; then
  printf 'Homebrew not found; install Homebrew first\n' >&2
  exit 1
fi
{{- end }}

# Internal retry-context marker is injected only by make caddy-setup; it is not
# a user configuration setting. Save it before sourcing ~/.env.
_CADDY_EXPLICIT_RETRY="${CADDY_EXPLICIT_RETRY:-0}"

# Check gate BEFORE sudo re-exec — avoids unnecessary password prompts when
# Caddy setup is disabled. Load ~/.env directly (no lib sourcing needed yet).
if [[ -f "$HOME/.env" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.env"
fi
CADDY_EXPLICIT_RETRY="$_CADDY_EXPLICIT_RETRY"
if [[ "${DOTFILES_RUN_CADDY_SETUP:-0}" != "1" ]]; then
  printf 'DOTFILES_RUN_CADDY_SETUP=%s — skipping Caddy setup\n' "${DOTFILES_RUN_CADDY_SETUP:-0}"
  exit 0
fi

{{- if eq .chezmoi.os "darwin" }}

if [[ "$(id -u)" -ne 0 ]]; then
  if [[ ! -t 0 && ! -t 2 ]]; then
    if ! sudo -n true 2>/dev/null; then
      printf 'Caddy setup needs sudo; skipping in a noninteractive session. Run make caddy-setup in a terminal to retry.\n' >&2
      if [[ "$_CADDY_EXPLICIT_RETRY" == "1" ]]; then
        exit 1
      fi
      exit 0
    fi
    exec sudo -n --preserve-env=BREW_BIN,DOTFILES_RUN_CADDY_SETUP,DOTFILES_LITELLM_UI_EXPOSED,CADDY_EXPLICIT_RETRY "$0" "$@"
  fi
  exec sudo --preserve-env=BREW_BIN,DOTFILES_RUN_CADDY_SETUP,DOTFILES_LITELLM_UI_EXPOSED,CADDY_EXPLICIT_RETRY "$0" "$@"
fi

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
# shellcheck disable=SC1091
source "$LIB_DIR/common.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/env.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/caddy_helpers.sh"

REAL_USER="${SUDO_USER:-}"
if [[ -z "$REAL_USER" || "$REAL_USER" == "root" ]]; then
  REAL_USER="{{ .chezmoi.username }}"
fi
REAL_HOME="/Users/${REAL_USER}"
export HOME="$REAL_HOME"

# Reload env under correct HOME (may already be loaded from pre-sudo check)
load_env || warn "\$HOME/.env not found, skipping env load"
PATH="$(dirname "$BREW_BIN"):${PATH}"
export PATH

BREW_PREFIX="$($BREW_BIN --prefix)"
CADDYFILE_PATH="${BREW_PREFIX}/etc/caddy/Caddyfile"
PLIST_PATH="/Library/LaunchDaemons/com.caddy.proxy.plist"
OLD_PLIST_PATH="$REAL_HOME/Library/LaunchAgents/com.caddy.proxy.plist"

info "Installing Caddy..."
sudo -u "$REAL_USER" env HOME="$REAL_HOME" PATH="$PATH" DOTFILES_RUN_CADDY_SETUP="${DOTFILES_RUN_CADDY_SETUP:-0}" "$BREW_BIN" install caddy
command -v caddy >/dev/null 2>&1 || die "Caddy binary is unavailable after installation"

info "Generating Caddyfile..."
mkdir -p "$(dirname "$CADDYFILE_PATH")"
CANDIDATE="$(mktemp "${CADDYFILE_PATH}.candidate.XXXXXX")"
PREVIOUS_CADDYFILE=""
PREVIOUS_PLIST=""
PREVIOUS_HOSTS=""
HOSTS_PUBLISHED=0
PLIST_CANDIDATE=""
CADDY_PUBLISHED=0
# Failures after publication restore both on-disk files and attempt to restart
# the previous root service. This is best-effort recovery, not a health receipt.
caddy_finish() {
  local status=$?
  trap - EXIT
  set +e
  if [[ "$status" -ne 0 && "$CADDY_PUBLISHED" == "1" ]]; then
    warn "Caddy apply failed; restoring previous Caddyfile and root plist"
    if [[ -n "$PREVIOUS_CADDYFILE" ]]; then
      cp -p "$PREVIOUS_CADDYFILE" "$CADDYFILE_PATH" || warn "Could not restore previous Caddyfile"
    else
      rm -f "$CADDYFILE_PATH" || warn "Could not remove uncommitted Caddyfile"
    fi
    if [[ -n "$PREVIOUS_PLIST" ]]; then
      cp -p "$PREVIOUS_PLIST" "$PLIST_PATH" || warn "Could not restore previous root plist"
    else
      rm -f "$PLIST_PATH" || warn "Could not remove uncommitted root plist"
    fi
    launchctl bootout system/com.caddy.proxy 2>/dev/null || true
    if [[ -n "$PREVIOUS_PLIST" && -n "$PREVIOUS_CADDYFILE" ]]; then
      launchctl bootstrap system/ "$PLIST_PATH" || warn "Old Caddy root service needs manual recovery"
      caddy_reload "$CADDYFILE_PATH" || warn "Old Caddy configuration needs manual recovery"
    fi
    warn "Inspect sudo launchctl print system/com.caddy.proxy and effective routes; no new access mode is claimed"
  fi
  if [[ "$status" -ne 0 && "$HOSTS_PUBLISHED" == "1" && -n "$PREVIOUS_HOSTS" ]]; then
    cp -p "$PREVIOUS_HOSTS" /etc/hosts || warn "Could not restore previous /etc/hosts; manual recovery is required"
  fi
  rm -f -- "$CANDIDATE" "${PREVIOUS_CADDYFILE:-}" "${PREVIOUS_PLIST:-}" "${PREVIOUS_HOSTS:-}" "${PLIST_CANDIDATE:-}"
  exit "$status"
}
trap caddy_finish EXIT
chown "$REAL_USER" "$CANDIDATE"
chmod 600 "$CANDIDATE"
sudo -u "$REAL_USER" env HOME="$REAL_HOME" PATH="$PATH" DOTFILES_RUN_CADDY_SETUP="${DOTFILES_RUN_CADDY_SETUP:-0}" python3 "{{ .chezmoi.sourceDir }}/scripts/configure-caddy.py" --output "$CANDIDATE" --no-backup
VALIDATION_LOG="$(mktemp)"
if ! caddy validate --config "$CANDIDATE" 2>"$VALIDATION_LOG"; then
  head -n 1 "$VALIDATION_LOG" >&2
  rm -f "$VALIDATION_LOG"
  die "Caddy candidate validation failed; existing Caddyfile was preserved"
fi
rm -f "$VALIDATION_LOG"
if [[ -L "$CADDYFILE_PATH" || -e "$CADDYFILE_PATH" && ! -f "$CADDYFILE_PATH" ]]; then
  die "Refusing a non-regular or symlinked Caddyfile destination: $CADDYFILE_PATH"
fi
if [[ -e "$OLD_PLIST_PATH" || -L "$OLD_PLIST_PATH" ]]; then
  die "Legacy Caddy LaunchAgent exists; inspect/stop it explicitly before switching supervisors"
fi
if [[ -f "$CADDYFILE_PATH" ]]; then
  PREVIOUS_CADDYFILE="$(mktemp "${CADDYFILE_PATH}.rollback.XXXXXX")"
  cp -p "$CADDYFILE_PATH" "$PREVIOUS_CADDYFILE"
fi
if [[ -L "$PLIST_PATH" || -e "$PLIST_PATH" && ! -f "$PLIST_PATH" ]]; then
  die "Refusing a non-regular or symlinked root plist: $PLIST_PATH"
fi
if [[ -f "$PLIST_PATH" ]]; then
  PREVIOUS_PLIST="$(mktemp "${PLIST_PATH}.rollback.XXXXXX")"
  cp -p "$PLIST_PATH" "$PREVIOUS_PLIST"
fi
chmod 0644 "$CANDIDATE"
chown root:wheel "$CANDIDATE"
CADDY_PUBLISHED=1
mv -f "$CANDIDATE" "$CADDYFILE_PATH"

info "Writing staged Caddy LaunchDaemon..."
PLIST_CANDIDATE="$(mktemp "${PLIST_PATH}.candidate.XXXXXX")"
cat >"$PLIST_CANDIDATE" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caddy.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>${BREW_PREFIX}/bin/caddy</string>
    <string>run</string>
    <string>--config</string>
    <string>${BREW_PREFIX}/etc/caddy/Caddyfile</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/com.caddy.proxy.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.caddy.proxy.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>${REAL_HOME}</string>
    <key>PATH</key>
    <string>${PATH}</string>
  </dict>
</dict>
</plist>
EOF

chown root:wheel "$PLIST_CANDIDATE"
chmod 644 "$PLIST_CANDIDATE"
plutil -lint "$PLIST_CANDIDATE" >/dev/null
mv -f "$PLIST_CANDIDATE" "$PLIST_PATH"

info "Loading Caddy LaunchDaemon..."
launchctl bootout system/com.caddy.proxy 2>/dev/null || true
sleep 2
launchctl bootstrap system/ "$PLIST_PATH"

caddy_validate "$CADDYFILE_PATH"
caddy_reload "$CADDYFILE_PATH"

info "Ensuring Caddy-served domains resolve in /etc/hosts..."
# Caddy serves OpenCode web at opencode.localhost and Open WebUI at
# chat.localhost (all modes) plus:
# - localhost: local.* domains and their opencode subdomains
# - lan/public: all domains and their opencode subdomains
# macOS doesn't auto-resolve *.localhost subdomains or local.* domains, so add entries to /etc/hosts.
HOSTS_FILE="/etc/hosts"
# Preserve the full existing hosts file in case any subsequent step fails.
PREVIOUS_HOSTS="$(mktemp "${HOSTS_FILE}.rollback.XXXXXX")"
cp -p "$HOSTS_FILE" "$PREVIOUS_HOSTS"
HOSTS_PUBLISHED=1
MARKER="# dotfiles-caddy-managed"
# Remove old managed entries (idempotent)
if grep -Fq "$MARKER" "$HOSTS_FILE" 2>/dev/null; then
  tmp_file="$(mktemp)"
  grep -Fv "$MARKER" "$HOSTS_FILE" >"$tmp_file" || true
  cat "$tmp_file" >"$HOSTS_FILE"
  rm -f "$tmp_file"
fi

SCRIPT_DIR="{{ .chezmoi.sourceDir }}/scripts"
HOSTS_ENTRIES="$(
  SCRIPT_DIR="$SCRIPT_DIR" REAL_HOME="$REAL_HOME" CADDY_ACCESS="${CADDY_ACCESS:-localhost}" DOTFILES_RUN_OPENWEBUI_SETUP="${DOTFILES_RUN_OPENWEBUI_SETUP:-0}" DOTFILES_LITELLM_UI_EXPOSED="${DOTFILES_LITELLM_UI_EXPOSED:-0}" DOTFILES_RUN_PASEO_WEB_SETUP="${DOTFILES_RUN_PASEO_WEB_SETUP:-0}" python3 - <<'PY' 2>/dev/null || true
import os
import sys
from pathlib import Path

script_dir = os.environ["SCRIPT_DIR"]
sys.path.insert(0, os.path.join(script_dir, "lib"))

from caddy_domains import HostServices, build_hosts_entries, load_domains

zones_path = Path(
    os.path.expanduser(os.environ.get("CADDY_ZONES_CONFIG", "~/.config/caddy/ddns-zones.json"))
)
domains = load_domains(zones_path)
entries = build_hosts_entries(
    domains,
    os.environ.get("CADDY_ACCESS", "localhost"),
    HostServices(
        openwebui_enabled=os.environ.get("DOTFILES_RUN_OPENWEBUI_SETUP", "0") == "1",
        litellm_ui_exposed=os.environ.get("DOTFILES_LITELLM_UI_EXPOSED", "0") == "1",
        paseo_enabled=os.environ.get("DOTFILES_RUN_PASEO_WEB_SETUP", "0") == "1",
    ),
)

for entry in entries:
    print(entry)
PY
)" || die "Caddy host entry generation failed; previous configuration will be restored"

if [[ -n "$HOSTS_ENTRIES" ]]; then
  {
    echo "$MARKER"
    printf '%s\n' "$HOSTS_ENTRIES"
  } >>"$HOSTS_FILE"
fi
ok "/etc/hosts updated with Caddy-served domain entries"

# Clear Caddy autosave to force fresh TLS config load
AUTOSAVE_PATH="$REAL_HOME/Library/Application Support/Caddy/autosave.json"
if [[ -f "$AUTOSAVE_PATH" ]]; then
  info "Clearing Caddy autosave at $AUTOSAVE_PATH..."
  rm -f "$AUTOSAVE_PATH" || warn "Failed to clear Caddy autosave"
fi


# The new root service, generated config and selected host routes were applied.
CADDY_PUBLISHED=0
ok "Caddy setup complete."
{{- else if eq .chezmoi.os "linux" }}

if [[ "$(id -u)" -ne 0 && ! -t 0 && ! -t 2 ]]; then
  if ! sudo -n true 2>/dev/null; then
    printf 'Caddy setup needs sudo; skipping in a noninteractive session. Run make caddy-setup in a terminal to retry.\n' >&2
    if [[ "$_CADDY_EXPLICIT_RETRY" == "1" ]]; then
      exit 1
    fi
    exit 0
  fi
  # Keep every later privileged command noninteractive, including apt and tee.
  sudo() { command sudo -n "$@"; }
fi

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
# shellcheck disable=SC1091
source "$LIB_DIR/common.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/env.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/caddy_helpers.sh"

load_env || warn "\$HOME/.env not found, skipping env load"
REAL_HOME="$HOME"
REAL_USER="$(whoami)"
export HOME="$REAL_HOME"
PATH="/usr/local/bin:/usr/bin:/bin:${REAL_HOME}/.local/bin:${PATH}"
export PATH
CADDYFILE_PATH="/etc/caddy/Caddyfile"

if ! command -v caddy >/dev/null 2>&1; then
  info "Installing Caddy..."
  if ! sudo apt-get update || ! sudo apt-get install -y caddy; then
    warn "apt-get could not install Caddy; trying the official binary"
    arch="$(uname -m)"
    case "$arch" in
    x86_64) arch="amd64" ;;
    aarch64 | arm64) arch="arm64" ;;
    *) die "Unsupported Linux architecture for Caddy: $arch" ;;
    esac
    caddy_tmp="$(mktemp)"
    curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=${arch}" -o "$caddy_tmp" || die "Failed to download Caddy"
    sudo install -m 0755 "$caddy_tmp" /usr/bin/caddy
    rm -f "$caddy_tmp"
  fi
fi

info "Generating Caddyfile..."
sudo -E env HOME="$REAL_HOME" PATH="$PATH" DOTFILES_RUN_CADDY_SETUP="${DOTFILES_RUN_CADDY_SETUP:-0}" python3 "{{ .chezmoi.sourceDir }}/scripts/configure-caddy.py"
# configure-caddy.py uses the shared /usr prefix on Linux; keep the service's
# conventional /etc/caddy path in sync for distro-installed Caddy.
if [[ -f /usr/etc/caddy/Caddyfile && ! -f "$CADDYFILE_PATH" ]]; then
  sudo mkdir -p /etc/caddy
  sudo cp /usr/etc/caddy/Caddyfile "$CADDYFILE_PATH"
fi

info "Ensuring Caddy-served domains resolve in /etc/hosts..."
HOSTS_FILE="/etc/hosts"
MARKER="# dotfiles-caddy-managed"
if sudo grep -Fq "$MARKER" "$HOSTS_FILE" 2>/dev/null; then
  tmp_file="$(mktemp)"
  sudo grep -Fv "$MARKER" "$HOSTS_FILE" >"$tmp_file" || true
  sudo install -m 0644 "$tmp_file" "$HOSTS_FILE"
  rm -f "$tmp_file"
fi

SCRIPT_DIR="{{ .chezmoi.sourceDir }}/scripts"
HOSTS_ENTRIES="$({
  SCRIPT_DIR="$SCRIPT_DIR" REAL_HOME="$REAL_HOME" CADDY_ACCESS="${CADDY_ACCESS:-localhost}" DOTFILES_RUN_OPENWEBUI_SETUP="${DOTFILES_RUN_OPENWEBUI_SETUP:-0}" DOTFILES_LITELLM_UI_EXPOSED="${DOTFILES_LITELLM_UI_EXPOSED:-0}" DOTFILES_RUN_PASEO_WEB_SETUP="${DOTFILES_RUN_PASEO_WEB_SETUP:-0}" python3 - <<'PY' 2>/dev/null || true
import os
import sys
from pathlib import Path

script_dir = os.environ["SCRIPT_DIR"]
sys.path.insert(0, os.path.join(script_dir, "lib"))
from caddy_domains import load_domains
from caddy_domains import HostServices, build_hosts_entries

zones_path = Path(os.path.expanduser(os.environ.get("CADDY_ZONES_CONFIG", "~/.config/caddy/ddns-zones.json")))
domains = load_domains(zones_path)
entries = build_hosts_entries(
    domains,
    os.environ.get("CADDY_ACCESS", "localhost"),
    HostServices(
        openwebui_enabled=os.environ.get("DOTFILES_RUN_OPENWEBUI_SETUP", "0") == "1",
        litellm_ui_exposed=os.environ.get("DOTFILES_LITELLM_UI_EXPOSED", "0") == "1",
        paseo_enabled=os.environ.get("DOTFILES_RUN_PASEO_WEB_SETUP", "0") == "1",
    ),
)
for entry in entries:
    print(entry)
PY
})"
if [[ -n "$HOSTS_ENTRIES" ]]; then
  {
    echo "$MARKER"
    printf '%s\n' "$HOSTS_ENTRIES"
  } | sudo tee -a "$HOSTS_FILE" >/dev/null
fi
ok "/etc/hosts updated with Caddy-served domain entries"

info "Writing Caddy systemd service..."
sudo tee /etc/systemd/system/caddy.service >/dev/null <<EOF
[Unit]
Description=Caddy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /etc/caddy/Caddyfile
Restart=always
RestartSec=5
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl daemon-reload
sudo systemctl enable --now caddy

caddy_validate "$CADDYFILE_PATH"
caddy_reload "$CADDYFILE_PATH"
ok "Caddy systemd setup complete."
{{- else }}
info "Skipping Caddy setup on {{ .chezmoi.os }}"
{{- end }}
