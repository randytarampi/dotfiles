#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"
source "${LIB_DIR}/tier_detect.sh"
source "${LIB_DIR}/tier_args.sh"

# Script hash triggers (re-run when opencode config or tiers change):
# configs/opencode/oh-my-opencode-slim.json: {{ include "configs/opencode/oh-my-opencode-slim.json" | sha256sum }}
# configs/opencode/openai-models.json: {{ include "configs/opencode/openai-models.json" | sha256sum }}
# configs/opencode/ollama-cloud-models.json: {{ include "configs/opencode/ollama-cloud-models.json" | sha256sum }}
# configs/opencode/anthropic-models.json: {{ include "configs/opencode/anthropic-models.json" | sha256sum }}
# configs/opencode/github-copilot-models.json: {{ include "configs/opencode/github-copilot-models.json" | sha256sum }}
# configs/opencode/opencode-models.json: {{ include "configs/opencode/opencode-models.json" | sha256sum }}
# scripts/lib/tier_registry.py: {{ include "scripts/lib/tier_registry.py" | sha256sum }}
# scripts/lib/tier_resolve.py: {{ include "scripts/lib/tier_resolve.py" | sha256sum }}
# scripts/lib/opencode_config.py: {{ include "scripts/lib/opencode_config.py" | sha256sum }}
# scripts/lib/models_dev.py: {{ include "scripts/lib/models_dev.py" | sha256sum }}
# scripts/lib/constants.py: {{ include "scripts/lib/constants.py" | sha256sum }}
# configs/opencode/vibeguard.config.json: {{ include "configs/opencode/vibeguard.config.json" | sha256sum }}
# dot_config/opencode/dcp.jsonc: {{ include "dot_config/opencode/dcp.jsonc" | sha256sum }}
# scripts/configure-opencode.py: {{ include "scripts/configure-opencode.py" | sha256sum }}
# scripts/configure-opencode-tier.py: {{ include "scripts/configure-opencode-tier.py" | sha256sum }}
# scripts/configure-opencode-voice.py: {{ include "scripts/configure-opencode-voice.py" | sha256sum }}
# scripts/configure-opencode-dcp.py: {{ include "scripts/configure-opencode-dcp.py" | sha256sum }}
# scripts/configure-acp-agents.py: {{ include "scripts/configure-acp-agents.py" | sha256sum }}
# scripts/verify-slim-invariants.py: {{ include "scripts/verify-slim-invariants.py" | sha256sum }}

# Load environment for API keys (must happen before gate)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_OPENCODE_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_OPENCODE_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OPENCODE_SETUP='${DOTFILES_RUN_OPENCODE_SETUP:-0}' — skipping opencode tier configuration"
  exit 0
fi

info "Configuring opencode..."

# Determine tier based on available API keys and CLI authentication
detect_tier DOTFILES_OPENCODE_TIER
info "Local tiers (local-pro, local-mini, local-nano, local-solo) are available via DOTFILES_OPENCODE_TIER"

# Forward local fallback configuration from environment variables
build_tier_extra_args

# Run opencode configuration script FIRST (creates oh-my-opencode-slim.json)
CONFIGURE_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/configure-opencode.py"
if [[ -f "$CONFIGURE_SCRIPT" ]]; then
  info "Running opencode configuration..."
  "$CONFIGURE_SCRIPT" --preset "$TIER" "${TIER_EXTRA_ARGS[@]+"${TIER_EXTRA_ARGS[@]}"}"
fi

ok "opencode configured (tier: $TIER)."
