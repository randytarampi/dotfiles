#!/usr/bin/env bash
set -euo pipefail
# env gate fingerprint: {{ env "DOTFILES_RUN_OPENCODE_TOOLS_SETUP" | sha256sum }}

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/env.sh"

# Hash triggers (re-run when cloud model registry changes):
# configs/opencode/ollama-cloud-models.json: {{ include "configs/opencode/ollama-cloud-models.json" | sha256sum }}
# scripts/lib/ollama_cloud_models.py: {{ include "scripts/lib/ollama_cloud_models.py" | sha256sum }}

# Load env before gate (DOTFILES_RUN_OPENCODE_TOOLS_SETUP is in ~/.env)
load_env || warn "\$HOME/.env not found, skipping env load"

# Gate on DOTFILES_RUN_OPENCODE_TOOLS_SETUP env var (set in ~/.env)
if [[ "${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}" != "1" ]]; then
  info "DOTFILES_RUN_OPENCODE_TOOLS_SETUP='${DOTFILES_RUN_OPENCODE_TOOLS_SETUP:-0}' — skipping AI CLI tool setup"
  exit 0
fi

info "Installing standalone AI CLI tools..."

if command -v npm >/dev/null 2>&1; then
  if npm list -g @fission-ai/openspec >/dev/null 2>&1; then
    ok "openspec CLI already installed globally"
  else
    info "Installing @fission-ai/openspec globally..."
    if npm install -g @fission-ai/openspec@latest 2>/dev/null; then
      ok "openspec CLI installed globally"
    else
      warn "openspec CLI install failed"
    fi
  fi

  if npm list -g @colbymchenry/codegraph >/dev/null 2>&1; then
    ok "codegraph CLI already installed globally"
  else
    info "Installing @colbymchenry/codegraph globally..."
    if npm install -g @colbymchenry/codegraph@latest 2>/dev/null; then
      ok "codegraph CLI installed globally"
    else
      warn "codegraph CLI install failed — install manually with: npm i -g @colbymchenry/codegraph"
    fi
  fi
else
  warn "npm not found; skipping standalone AI CLI installs"
fi

# ---------------------------------------------------------------------------
# Ollama Cloud model metadata (pulled locally for OpenCode discovery)
#   Reads model names from configs/opencode/ollama-cloud-models.json
#   Each model is pulled as a :cloud stub so OpenCode can discover it
# ---------------------------------------------------------------------------
info "Pulling Ollama Cloud model metadata..."
CONFIG_FILE="{{ .chezmoi.sourceDir }}/configs/opencode/ollama-cloud-models.json"
if [ -f "$CONFIG_FILE" ]; then
  while IFS= read -r model; do
    ollama pull "${model}:cloud" 2>/dev/null || warn "Could not pull '${model}:cloud' — you may need 'ollama login' first"
  done < <(PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 -m ollama_cloud_models --registry "$CONFIG_FILE" --pull-list 2>/dev/null)
else
  warn "ollama-cloud-models.json not found at $CONFIG_FILE — skipping cloud model pull"
fi
ok "Ollama Cloud model metadata pulled"

# ---------------------------------------------------------------------------
# Remove stale Ollama Cloud model stubs no longer in the registry
#   (Cleans up retired models that were previously `ollama pull`ed as :cloud stubs)
# ---------------------------------------------------------------------------
info "Cleaning up stale Ollama Cloud model stubs..."
if command -v ollama &>/dev/null; then
  PYTHONPATH="{{ .chezmoi.sourceDir }}/scripts/lib" python3 -m ollama_cloud_models --registry "$CONFIG_FILE" --cleanup || warn "Could not remove stale cloud stubs"
fi
ok "Stale cloud model stub cleanup complete"

# ---------------------------------------------------------------------------
# lazyskills CLI (skill discovery and management)
#   macOS: brew cask (alvinunreal/tap/lazyskills)
#   Linux: curl installer (https://lazyskills.sh/install)
# ---------------------------------------------------------------------------
info "Installing lazyskills CLI..."
if command -v lazyskills &>/dev/null; then
  ok "lazyskills CLI already installed"
elif [[ "$(uname -s)" == "Darwin" ]]; then
  brew tap alvinunreal/tap 2>/dev/null || true
  brew install --cask lazyskills || warn "brew install --cask lazyskills failed — see scripts/install-skills.sh"
elif command -v curl &>/dev/null; then
  curl -fsSL https://lazyskills.sh/install | sh || warn "lazyskills curl install failed"
else
  warn "Cannot install lazyskills — see scripts/install-skills.sh for manual instructions"
fi
