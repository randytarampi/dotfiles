#!/bin/bash
set -euo pipefail

LIB_DIR="{{ .chezmoi.sourceDir }}/scripts/lib"
source "${LIB_DIR}/common.sh"

info "Installing opencode plugins..."

if ! command -v opencode >/dev/null 2>&1; then
  warn "opencode not found; skipping plugin installation."
  exit 0
fi

# Plugin definitions matching ~/.config/opencode/opencode.json
# opencode plugin <module> --global — installs the plugin and updates global config
PLUGINS=(
  "@tarquinen/opencode-dcp@latest"
  "@plannotator/opencode@latest"
  "oh-my-opencode-slim"
  "opencode-plugin-openspec"
)

for plugin in "${PLUGINS[@]}"; do
  if opencode plugin "${plugin}" --global 2>/dev/null; then
    ok "opencode plugin: ${plugin}"
  else
    warn "opencode plugin ${plugin} failed (may already be installed)"
  fi
done

# The meridian plugin is installed globally via npm and referenced by local path.
# No opencode plugin install needed — it's already at its nvm global path.
# Dynamically resolve meridian path from nvm default node version
NVM_DIR="$HOME/.nvm"
MERIDIAN_PATH=""
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  DEFAULT_VERSION=$(nvm version default 2>/dev/null || echo "")
  if [ -n "$DEFAULT_VERSION" ]; then
    MERIDIAN_PATH="$NVM_DIR/versions/node/$DEFAULT_VERSION/lib/node_modules/@rynfar/meridian/plugin/meridian.ts"
  fi
fi
if [[ -f "${MERIDIAN_PATH}" ]]; then
  ok "opencode plugin: meridian (already installed globally via npm)"
else
  warn "opencode plugin: meridian not found at ${MERIDIAN_PATH} — install @rynfar/meridian globally with npm"
fi

ok "opencode plugins: done."

# Install OpenSpec CLI globally (spec-driven development for AI coding)
if command -v npm >/dev/null 2>&1; then
  if npm list -g @fission-ai/openspec >/dev/null 2>&1; then
    ok "openspec CLI already installed globally"
  else
    info "Installing @fission-ai/openspec globally..."
    if npm install -g @fission-ai/openspec@latest 2>/dev/null; then
      ok "openspec CLI installed globally"
    else
      warn "openspec CLI install failed"
    fi
  fi
else
  warn "npm not found; skipping openspec CLI install"
fi

# Install CodeGraph CLI (local semantic code index + MCP server)
if command -v npm >/dev/null 2>&1; then
  if npm list -g @colbymchenry/codegraph >/dev/null 2>&1; then
    ok "codegraph CLI already installed globally"
  else
    info "Installing @colbymchenry/codegraph globally..."
    if npm install -g @colbymchenry/codegraph@latest 2>/dev/null; then
      ok "codegraph CLI installed globally"
    else
      warn "codegraph CLI install failed — install manually with: npm i -g @colbymchenry/codegraph"
    fi
  fi
else
  warn "npm not found; skipping codegraph CLI install"
fi

# Configure CodeGraph MCP for all detected agents (non-interactive, idempotent)
# This covers tools we don't manage in global-mcps.json (Claude Code, Hermes, Antigravity)
# plus confirms our managed tools are configured. Safe to re-run — shows "Unchanged" if
# codegraph is already in the agent's config.
if command -v codegraph >/dev/null 2>&1; then
  info "Configuring CodeGraph MCP for detected agents..."
  if codegraph install -y --target auto --location global >/dev/null 2>&1; then
    ok "CodeGraph MCP configured for detected agents"
  else
    warn "codegraph install failed — you can run 'codegraph install' manually"
  fi
else
  warn "codegraph CLI not found; skipping agent MCP config"
fi
