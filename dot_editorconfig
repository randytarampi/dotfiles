# EditorConfig is awesome: http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.json]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.toml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Markdown list and code-block indentation is structural, not a fixed multiple.
indent_size = unset
# Markdown prose is soft-wrapped; trailing double spaces can encode hard breaks.
max_line_length = off

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
