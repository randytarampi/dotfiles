{
  "name": "basic-memory",
  "type": "command",
  "command": "uvx",
  "args": [
    "--prerelease=allow",
    "--from",
    "basic-memory==1.0.0",
    "basic-memory",
    "mcp"
  ],
  "env": {
    "BASIC_MEMORY_NO_PROMOS": "1",
    "BASIC_MEMORY_LOGFIRE_ENABLED": "false",
    "BASIC_MEMORY_LOGFIRE_SEND_TO_LOGFIRE": "false",
    "OTEL_SDK_DISABLED": "true",
    "BASIC_MEMORY_FORCE_LOCAL": "true",
    "BASIC_MEMORY_AUTO_UPDATE": "false",
    "BASIC_MEMORY_RERANKER_ENABLED": "true",
    "BASIC_MEMORY_RERANKER_PROVIDER": "fastembed",
    "BASIC_MEMORY_RERANKER_MODEL": "jinaai/jina-reranker-v1-tiny-en",
    "BASIC_MEMORY_SEMANTIC_EMBEDDING_PROVIDER": "fastembed"
  },
  "note": "Pinned local Basic Memory MCP across managed global agents; cross-encoder rerank, privacy and local routing. uvx must be installed."
}
