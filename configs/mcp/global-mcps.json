        {
          "template": "basic-memory"
        },
        {
          "template": "context7"
        },
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "xcode",
          "opt_in_gate": "DOTFILES_RUN_XCODE_MCP_SETUP"
        }
      ]
    },
    "opencode": {
      "mcp_path": "~/.config/opencode/opencode.json",
      "project_mcp_path": "opencode.json",
      "format": "opencode-internal",
      "mcp_servers": [
