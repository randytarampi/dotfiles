          "template": "basic-memory"
        },
        {
          "template": "context7"
        },
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph",
          "extra_fields": {
            "enabled": true
          }
        },
        {
          "template": "xcode",
          "opt_in_gate": "DOTFILES_RUN_XCODE_MCP_SETUP"
        }
      ]
    },
