{
  "project_mcp_templates": [
    "betterstack",
    "codegraph",
    "mongodb",
    "notion",
    "shortcut",
    "atlassian",
    "testrigor"
  ],
  "tools": {
    "ai": {
      "mcp_path": "~/.ai/mcp/mcp.json",
      "project_mcp_path": ".ai/mcp/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "basic-memory"
        },
        {
          "template": "context7"
        },
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "xcode",
          "opt_in_gate": "DOTFILES_RUN_XCODE_MCP_SETUP"
        }
      ]
    },
    "air": {
      "mcp_path": "~/.ai/mcp/mcp.json",
      "project_mcp_path": ".ai/mcp/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "basic-memory"
        },
        {
          "template": "context7"
        },
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "xcode",
          "opt_in_gate": "DOTFILES_RUN_XCODE_MCP_SETUP"
        }
      ]
    },
    "cursor": {
      "mcp_path": "~/.cursor/mcp.json",
      "project_mcp_path": ".cursor/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "basic-memory"
        },
        {
          "template": "context7"
        },
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph",
          "extra_fields": {
            "args": [
              "serve",
              "--mcp",
              "--path",
              "${workspaceFolder}"
            ]
          }
        },
        {
          "template": "xcode",
          "opt_in_gate": "DOTFILES_RUN_XCODE_MCP_SETUP"
        }
      ]
    },
    "codex": {
      "mcp_path": "~/.codex/config.toml",
