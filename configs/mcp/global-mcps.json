{
  "project_mcp_templates": ["betterstack", "codegraph", "mongodb", "notion", "shortcut", "smallcode"],
  "tools": {
    "ai": {
      "mcp_path": "~/.ai/mcp/mcp.json",
      "project_mcp_path": ".ai/mcp/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "smallcode"
        }
      ]
    },
    "air": {
      "mcp_path": "~/.ai/mcp/mcp.json",
      "project_mcp_path": ".ai/mcp/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "smallcode"
        }
      ]
    },
    "cursor": {
      "mcp_path": "~/.cursor/mcp.json",
      "project_mcp_path": ".cursor/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph",
          "extra_fields": {
            "args": ["serve", "--mcp", "--path", "${workspaceFolder}"]
          }
        },
        {
          "template": "smallcode"
        }
      ]
    },
    "codex": {
      "mcp_path": "~/.codex/config.toml",
      "project_mcp_path": ".codex/config.toml",
      "format": "toml-mcpServers",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "smallcode"
        }
      ]
    },
    "opencode": {
      "mcp_path": "~/.config/opencode/opencode.json",
      "project_mcp_path": "opencode.json",
      "format": "opencode-internal",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph",
          "extra_fields": {
            "enabled": true
          }
        },
        {
          "template": "smallcode",
          "extra_fields": {
            "enabled": true
          }
        }
      ]
    },
    "gemini": {
      "mcp_path": "~/.gemini/settings.json",
      "project_mcp_path": ".gemini/settings.json",
      "format": "json-settings-merge",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "smallcode"
        }
      ]
    },
    "junie": {
      "mcp_path": "~/.ai/mcp/mcp.json",
      "project_mcp_path": ".ai/mcp/mcp.json",
      "format": "json-mcpServers",
      "mcp_servers": [
        {
          "template": "github",
          "name_override": "github"
        },
        {
          "template": "idea"
        },
        {
          "template": "sentry",
          "name_override": "Sentry"
        },
        {
          "template": "codegraph"
        },
        {
          "template": "smallcode"
        }
      ]
    }
  }
}
