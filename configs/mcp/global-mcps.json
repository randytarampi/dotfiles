      "mcp_path": "~/.claude.json",
      "project_mcp_path": ".claude/mcp.json",
      "format": "json-mcpServers-merge",
      "note": "Claude Code CLI. ~/.claude.json is a shared app config with many top-level keys; merge preserves them. Project-mode writes to .claude/mcp.json.",
