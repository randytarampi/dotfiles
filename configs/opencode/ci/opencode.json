{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "mcp": {
    "context7": {"type": "remote", "url": "https://mcp.context7.com/mcp"},
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {"Authorization": "Bearer {env:GITHUB_TOKEN}"}
    },
    "grep": {"type": "remote", "url": "https://mcp.grep.app"},
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {"baseURL": "https://opencode.ai/zen/v1"},
      "models": {
        "big-pickle": {"name": "big-pickle"},
        "muse-spark-1.3-contributor-free": {"name": "muse-spark-1.3-contributor-free"},
        "nemotron-3.5-lightning-free": {"name": "nemotron-3.5-lightning-free"},
        "mimo-v2.5-free": {"name": "mimo-v2.5-free"}
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "models": {
        "gemini-3.8-flash": {"name": "gemini-3.8-flash"},
        "gemini-3.5-flash-lite": {"name": "gemini-3.5-flash-lite"},
        "gemini-2.5-pro": {"name": "gemini-2.5-pro"}
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@openrouter/ai-sdk-provider",
      "options": {"baseURL": "https://openrouter.ai/api/v1"},
      "models": {
        "nvidia/nemotron-3-super-120b-a12b:free": {"name": "Nemotron 3 Super 120B (free)"},
        "nvidia/nemotron-3.5-lightning:free": {"name": "Nemotron 3.5 Lightning (free)"},
        "nvidia/nemotron-3-super-120b-a12b:free": {"name": "Nemotron 3 Super 120B (free)"},
        "nvidia/nemotron-3-ultra-550b-a55b:free": {"name": "Nemotron 3 Ultra 550B (free)"},
        "minimax/minimax-m2.7:free": {"name": "MiniMax M2.7 (free)"},
        "cohere/north-mini-code:free": {"name": "North Mini Code (free)"},
        "poolside/laguna-s-2.1:free": {"name": "Laguna S 2.1 (free)"},
        "thinkingmachines/inkling-small:free": {"name": "Inkling Small (free)"}
      }
    }
  }
}
