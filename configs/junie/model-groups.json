{
  "providers": {
    "ollama-cloud": {
      "baseUrl": "https://ollama.com/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "baseUrlEnv": "OLLAMA_CLOUD_BASE_URL"
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrlEnv": "OPENAI_BASE_URL"
    },
    "meridian": {
      "baseUrl": "http://127.0.0.1:3456/v1/responses",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "MERIDIAN_API_KEY",
      "hostEnv": "MERIDIAN_HOST",
      "portEnv": "MERIDIAN_PORT",
      "baseUrlEnv": "ANTHROPIC_BASE_URL"
    },
    "ollama": {
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "",
      "hostEnv": "OLLAMA_LOCAL_HOST",
      "portEnv": "OLLAMA_LOCAL_PORT",
      "hostEnvAlt": "OLLAMA_HOST"
    },
    "github-copilot": {
      "baseUrl": "https://api.githubcopilot.com/v1",
      "apiKeyEnv": "GITHUB_TOKEN",
      "apiType": "OpenAIResponses"
    }
  },
  "modelTemperatures": {
    "anthropic": 1,
    "claude": 1,
    "deepseek": 0,
    "gemini": 1,
    "gemma": 1,
    "glm": 0.7,
    "gpt": 1,
    "kimi": 0.8,
    "mimo": 0.3,
    "qwen": 0.6
  },
  "groups": {
    "meridian-opus": {
      "provider": "meridian",
      "primaryModel": "claude-opus-5"
    },
    "meridian-sonnet": {
      "provider": "meridian",
      "primaryModel": "claude-sonnet-5"
    },
    "meridian-haiku": {
      "provider": "meridian",
      "primaryModel": "claude-haiku-4-5"
    },
    "meridian-fable": {
      "provider": "meridian",
      "primaryModel": "claude-fable-5"
    },
    "copilot": {
      "provider": "github-copilot",
      "primaryModel": "copilot-model-id"
    }
  }
}
