{
  "providers": {
    "ollama-cloud": {
      "baseUrl": "https://ollama.com/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OLLAMA_API_KEY"
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "meridian": {
      "baseUrl": "http://127.0.0.1:3456/v1/responses",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "MERIDIAN_API_KEY",
      "hostEnv": "MERIDIAN_HOST",
      "portEnv": "MERIDIAN_PORT"
    },
    "ollama-local": {
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": ""
    }
  },
  "modelTemperatures": {
    "anthropic": 1,
    "claude": 1,
    "deepseek": 0,
    "gemini": 1,
    "gemma": 1,
    "glm": 0.7,
    "gpt": 1,
    "kimi": 0.8,
    "mimo": 0.3,
    "qwen": 0.6
  },
  "groups": {
    "pro": {
      "provider": "ollama-cloud",
      "primaryModel": "glm-5.1",
      "fasterModel": "gemma4:31b"
    },
    "pro-plus": {
      "provider": "ollama-cloud",
      "primaryModel": "glm-5.1",
      "fasterModel": "gpt-5.4-mini",
      "fasterProvider": "openai"
    },
    "pro-plus-anthropic": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-opus-4-6",
      "fasterModel": "anthropic/claude-haiku-4-5"
    },
    "anthropic": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-opus-4-6",
      "fasterModel": "anthropic/claude-haiku-4-5"
    },
    "plus": {
      "provider": "openai",
      "primaryModel": "gpt-5.5",
      "fasterModel": "gpt-5.4-nano"
    },
    "plus-anthropic": {
      "provider": "openai",
      "primaryModel": "gpt-5.5",
      "fasterModel": "anthropic/claude-haiku-4-5",
      "fasterProvider": "meridian"
    },
    "local-pro": {
      "provider": "ollama-local",
      "primaryModel": "_local:reasoning",
      "fasterModel": "_local:lightweight"
    },
    "local": {
      "provider": "ollama-local",
      "primaryModel": "_local:code-gen",
      "fasterModel": "_local:lightweight"
    },
    "local-mini": {
      "provider": "ollama-local",
      "primaryModel": "_local:code-gen",
      "fasterModel": "_local:vision"
    },
    "local-nano": {
      "provider": "ollama-local",
      "primaryModel": "_local:code-gen"
    },
    "local-solo": {
      "provider": "ollama-local",
      "primaryModel": "_local:solo",
      "fasterModel": "_local:solo"
    },
    "meridian-opus": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-opus-4-6"
    },
    "meridian-sonnet": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-sonnet-4-6"
    },
    "meridian-haiku": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-haiku-4-5-20251001"
    },
    "meridian-fable": {
      "provider": "meridian",
      "primaryModel": "anthropic/claude-fable-5"
    }
  }
}
