{
  "providers": {
    "ollama-cloud": {
      "baseUrl": "https://ollama.com/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "baseUrlEnv": "OLLAMA_CLOUD_BASE_URL"
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrlEnv": "OPENAI_BASE_URL"
    },
    "litellm": {
      "baseUrl": "http://127.0.0.1:4000/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "LITELLM_JUNIE_KEY"
    },
    "meridian": {
      "baseUrl": "http://127.0.0.1:3456/v1/responses",
      "apiType": "OpenAIResponses",
      "apiKeyEnv": "MERIDIAN_API_KEY",
      "hostEnv": "MERIDIAN_HOST",
      "portEnv": "MERIDIAN_PORT",
      "baseUrlEnv": "ANTHROPIC_BASE_URL"
    },
    "ollama": {
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "",
      "hostEnv": "OLLAMA_LOCAL_HOST",
      "portEnv": "OLLAMA_LOCAL_PORT",
      "hostEnvAlt": "OLLAMA_HOST"
    },
    "omlx": {
      "baseUrl": "http://127.0.0.1:8000/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OMLX_API_KEY",
      "hostEnv": "OMLX_HOST",
      "portEnv": "OMLX_PORT",
      "baseUrlEnv": "OMLX_BASE_URL"
    },
    "github-copilot": {
      "baseUrl": "https://api.githubcopilot.com/v1",
      "apiKeyEnv": "GITHUB_TOKEN",
      "apiType": "OpenAIResponses"
    },
    "google": {
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "GEMINI_API_KEY"
    },
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "opencode": {
      "baseUrl": "https://opencode.ai/zen/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "OPENCODE_API_KEY"
    },
    "groq": {
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "GROQ_API_KEY"
    },
    "mistral": {
      "baseUrl": "https://api.mistral.ai/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "MISTRAL_API_KEY"
    },
    "cloudflare": {
      "baseUrl": "",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN"
    },
    "nvidia-nim": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiType": "OpenAICompletion",
      "apiKeyEnv": "NVIDIA_NIM_API_KEY"
    }
  },
  "modelTemperatures": {
    "anthropic": 1,
    "claude": 1,
    "deepseek": 0,
    "gemini": 1,
    "gemma": 1,
    "glm": 0.7,
    "gpt": 1,
    "kimi": 0.8,
    "mimo": 0.3,
    "qwen": 0.6
  },
  "groups": {
    "anthropic-opus": {
      "provider": "meridian",
      "primaryModel": "claude-opus-5-5"
    },
    "anthropic-sonnet": {
      "provider": "meridian",
      "primaryModel": "claude-sonnet-5-5"
    },
    "anthropic-haiku": {
      "provider": "meridian",
      "primaryModel": "claude-haiku-5-5"
    },
    "anthropic-fable": {
      "provider": "meridian",
      "primaryModel": "claude-fable-5-1"
    },
    "anthropic": {
      "provider": "meridian",
      "primaryModel": "claude-opus-5-5",
      "fasterModel": "claude-haiku-5-5",
      "fasterProvider": "meridian"
    },
    "google-gemini-flash": {
      "provider": "google",
      "primaryModel": "gemini-3.8-flash",
      "fasterModel": "gemini-3.5-flash-lite",
      "fasterProvider": "google"
    },
    "openai-astra": {
      "provider": "openai",
      "primaryModel": "gpt-6-astra"
    },
    "openai-luna": {
      "provider": "openai",
      "primaryModel": "gpt-6-luna"
    },
    "openai-sol": {
      "provider": "openai",
      "primaryModel": "gpt-6.1-sol"
    },
    "openai": {
      "provider": "openai",
      "primaryModel": "gpt-6.1-sol",
      "fasterModel": "gpt-6-luna",
      "fasterProvider": "openai"
    },
    "ollama-cloud-glm": {
      "provider": "ollama-cloud",
      "primaryModel": "glm-5.3",
      "fasterModel": "glm-5.3-flash",
      "fasterProvider": "ollama-cloud"
    },
    "ollama-cloud-nemotron": {
      "provider": "ollama-cloud",
      "primaryModel": "nemotron-3-ultra",
      "fasterModel": "nemotron-3-super",
      "fasterProvider": "ollama-cloud"
    },
    "ollama-cloud-deepseek": {
      "provider": "ollama-cloud",
      "primaryModel": "deepseek-v4-pro:0813",
      "fasterModel": "deepseek-v4.1-flash",
      "fasterProvider": "ollama-cloud"
    },
    "ollama-cloud-minimax": {
      "provider": "ollama-cloud",
      "primaryModel": "minimax-m3",
      "fasterModel": "minimax-m3.1-flash",
      "fasterProvider": "ollama-cloud"
    },
    "ollama-cloud-mistral": {
      "provider": "ollama-cloud",
      "primaryModel": "mistral-large-4"
    },
    "free": {},
    "openai-terra": {
      "provider": "openai",
      "primaryModel": "gpt-6.1-terra"
    },
    "ollama-cloud-mimo": {
      "provider": "ollama-cloud",
      "primaryModel": "mimo-v2.6-pro",
      "fasterModel": "mimo-v2.6-flash",
      "fasterProvider": "ollama-cloud"
    },
    "ollama-cloud-kimi": {
      "provider": "ollama-cloud",
      "primaryModel": "kimi-k3",
      "fasterModel": "kimi-k2.7-code",
      "fasterProvider": "ollama-cloud"
    },
    "groq-gpt-oss": {
      "provider": "groq",
      "primaryModel": "openai/gpt-oss-120b",
      "fasterModel": "openai/gpt-oss-20b",
      "fasterProvider": "groq"
    },
    "mistral-small": {
      "provider": "mistral",
      "primaryModel": "mistral-small-latest"
    },
    "cloudflare-llama": {
      "provider": "cloudflare",
      "primaryModel": "@cf/meta/llama-3.1-8b-instruct-fp8"
    },
    "nvidia-nim-gpt-oss": {
      "provider": "nvidia-nim",
      "primaryModel": "openai/gpt-oss-20b"
    }
  },
  "sharedPresets": {
    "free": "free"
  },
  "compatibility": {
    "openai-gpt-6-luna": "openai-luna",
    "openai-gpt-6.1-sol": "openai-sol",
    "meridian-opus": "anthropic-opus",
    "meridian-sonnet": "anthropic-sonnet",
    "meridian-haiku": "anthropic-haiku",
    "meridian-fable": "anthropic-fable"
  }
}
