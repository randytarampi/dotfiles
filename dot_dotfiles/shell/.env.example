# dot_dotfiles/shell/.env.example
# Copy to ~/.env and fill in real values. This file is the canonical template
# for secrets, provider tokens, and dotfiles toggles.
# DO NOT commit .env — it is gitignored.
#
# Format: KEY='VALUE' (single-quoted, no "export" keyword)
# Loaded at shell startup via: set -a && source "$HOME/.env" && set +a

# --- Standard shell/shared settings ---
# LC_ALL='en_CA.UTF-8'
# LANG='en_CA.UTF-8'
# LANGUAGE='en_CA.UTF-8'
# EDITOR='emacs'
# VISUAL='emacs'
# HISTCONTROL='ignoreboth'
# HISTSIZE='1000'
# HISTFILESIZE='2000'
# ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX='YES'
# CLICOLOR='1'
# GREP_COLOR='1'
# GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# --- Dotfiles toggles (0 = skip, 1 = run during chezmoi apply) ---
# DOTFILES_RUN_MACOS_DEFAULTS='0'
# DOTFILES_RUN_MACOS_SECURITY='0'
# DOTFILES_RUN_INSTALL_PACKAGES='0'
# DOTFILES_RUN_JUNIE_CLI_SETUP='1'
# DOTFILES_RUN_OPENCODE_SETUP='1'
# DOTFILES_RUN_PLANNOTATOR_SETUP='1'
# DOTFILES_RUN_MCP_SETUP='1'
# DOTFILES_RUN_MERIDIAN_LAUNCHD='0'
# DOTFILES_RUN_VOICE_SETUP='0'
# DOTFILES_USE_LOCAL_OLLAMA='1'
# DOTFILES_OPENCODE_TIER='pro-plus'
# DOTFILES_ENV_FILE='${HOME}/.env'
# DOTFILES_PROMPT_USER_COLOUR='bold yellow'

# --- Telemetry opt-out ---
# OPENSPEC_TELEMETRY='0'
# DO_NOT_TRACK='1'

# --- Git identity (used by dot_gitconfig.tmpl + gpg.conf.tmpl) ---
# GIT_AUTHOR_NAME='Your Name'
# GIT_AUTHOR_EMAIL='you@example.com'
# GPG_SIGNING_KEY='YOUR_FULL_GPG_FINGERPRINT'

# --- GitHub ---
# GITHUB_USER='your-github-username'
# GH_TOKEN='ghp_...'

# --- Anthropic ---
# ANTHROPIC_API_KEY='sk-ant-...'

# --- Asana ---
# ASANA_API_TOKEN='2/...'

# --- AWS (used by private_dot_aws/credentials.tmpl) ---
# AWS_ACCESS_KEY_ID='AKIA...'
# AWS_SECRET_ACCESS_KEY='...'
# AWS_SESSION_TOKEN='...'             # Optional — set if using temporary credentials
# AWS_DEFAULT_REGION='us-east-1'
# AWS_DEFAULT_PROFILE='your-profile'

# --- Better Stack / Better Uptime ---
# BETTERUPTIME_API_TOKEN='your-token'
# BETTERSTACK_API_TOKEN='your-token'

# --- Bitbucket ---
# BITBUCKET_PRIVATE_TOKEN='your-token'

# --- BrowserStack ---
# BROWSERSTACK_USERNAME='your-username'
# BROWSERSTACK_ACCESS_KEY='your-key'

# --- Docker Hub ---
# DOCKER_HUB_API_TOKEN='dckr_pat_...'

# --- Gemini / Google ---
# GEMINI_API_KEY='AIza...'
# GOOGLE_CLOUD_PROJECT='your-project'

# --- GitLab ---
# GITLAB_API_ENDPOINT='https://gitlab.com/api/v4'
# GITLAB_API_PRIVATE_TOKEN='glpat-...'

# --- JetBrains MCP (machine-specific — run scripts/detect-ij-mcp.py) ---
# IJ_MCP_TRANSPORT='sse'
# IJ_MCP_SERVER_JAVA='/path/to/java'
# IJ_MCP_SERVER_CLASSPATH='/path/to/classpath'

# --- Meridian / Mozart Router ---
# MERIDIAN_API_KEY='your-meridian-api-key'
# MERIDIAN_HOST='127.0.0.1'
# MERIDIAN_PORT='3456'
# MOZART_CONFIG='${HOME}/.mozart/mozart.json'

# --- MongoDB Atlas / MCP ---
# MONGODB_ATLAS_PUBLIC_KEY='your-key'
# MONGODB_ATLAS_PRIVATE_KEY='your-secret'
# MDB_MCP_API_CLIENT_ID='your-client-id-or-public-key'
# MDB_MCP_API_CLIENT_SECRET='your-client-secret-or-private-key'

# --- npm ---
# NPM_TOKEN='npm_...'

# --- Ollama / OpenCode ---
# OLLAMA_API_KEY='your-ollama-cloud-key'
# OPENCODE_DIR='${HOME}/.config/opencode'
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS='true'

# --- OpenAI ---
# OPENAI_API_KEY='sk-...'

# --- Perfecto ---
# PERFECTO_USERNAME='you@example.com'
# PERFECTO_PASSWORD='your-password'

# --- Sauce Labs ---
# SAUCE_USERNAME='your-username'
# SAUCE_ACCESS_KEY='your-key'

# --- Sentry ---
# SENTRY_AUTH_TOKEN='sntryu_...'       # Canonical name; MCP exports as SENTRY_ACCESS_TOKEN

# --- Shortcut ---
# SHORTCUT_API_TOKEN='your-token'

# --- TestObject ---
# TESTOBJECT_ACCESS_KEY='your-key'

# --- Trello ---
# TRELLO_API_TOKEN='your-token'
# TRELLO_API_KEY='your-key'

# --- VueScan (used by private_dot_vuescanrc.tmpl) ---
# VUESCAN_USER_ID='your-uuid'
# VUESCAN_LICENSE='your-license'
# VUESCAN_CUSTOMER='your-customer-number'
# VUESCAN_EMAIL='you@example.com'
