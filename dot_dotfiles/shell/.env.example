# dot_dotfiles/shell/.env.example
# Copy to ~/.env and fill in real values. This file is the canonical template
# for secrets, provider tokens, and dotfiles toggles.
# DO NOT commit .env — it is gitignored.
#
# Format: KEY='VALUE' (single-quoted, no "export" keyword)
# Loaded at shell startup via: set -a && source "$HOME/.env" && set +a

# --- Standard shell/shared settings ---
# LC_ALL='en_CA.UTF-8'
# LANG='en_CA.UTF-8'
# LANGUAGE='en_CA.UTF-8'
# EDITOR='emacs'
# VISUAL='emacs'
# HISTCONTROL='ignoreboth'
# HISTSIZE='1000'
# HISTFILESIZE='2000'
# ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX='YES'
# CLICOLOR='1'
# GREP_COLOR='1'
# GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# --- Provider base-URL overrides (official SDK env vars) ---
# When set, these take priority over hardcoded provider URLs in all scripts.
# ANTHROPIC_BASE_URL='https://api.anthropic.com/v1'   # Anthropic SDK; also signals Meridian usage
# OPENAI_BASE_URL='https://api.openai.com/v1'          # OpenAI SDK

# --- Telemetry opt-out ---
# OPENSPEC_TELEMETRY='0'
# DO_NOT_TRACK='1'

# --- Dotfiles toggles (0 = skip, 1 = run during chezmoi apply / make deploy) ---
# Gates follow DOTFILES_RUN_*_SETUP pattern. Default 0 (opt-in) for fleet management.
# Phase 1: One-time setup (run_once_01-03) — no gates needed for 01, 03
# DOTFILES_RUN_MACOS_SECURITY_SETUP='0'       # Script 02: firewall, Gatekeeper, FileVault
# Phase 2: Package/CLI installs (run_onchange_04-11)
# DOTFILES_RUN_PACKAGES_SETUP='0'             # Script 04: Homebrew/Winget packages
# DOTFILES_BREWFILE_IGNORE=''                  # Comma-separated brew/cask names to skip (e.g. "zoom,slack")
# DOTFILES_WINGETFILE_IGNORE=''               # Comma-separated winget Package IDs to skip
# DOTFILES_RUN_JUNIE_CLI_SETUP='0'            # Script 06: Junie CLI + model profiles
# DOTFILES_RUN_OPENCODE_TOOLS_SETUP='0'       # Scripts 07, 08: OpenCode plugins + CLI tools
# DOTFILES_RUN_PLANNOTATOR_SETUP='0'          # Script 09: Plannotator CLI
# DOTFILES_RUN_ANTIGRAVITY_ACP_SETUP='0'      # Script 10: antigravity-acp bridge (agy-acp) install
# DOTFILES_RUN_SMALLCODE_SETUP='0'            # Scripts 10, 18: SmallCode install + config
# DOTFILES_RUN_MERIDIAN_SETUP='0'             # Script 11: Meridian launchd plist (macOS)
# Phase 3: Tool configuration (run_onchange_12-20)
# DOTFILES_RUN_MACOS_DEFAULTS_SETUP='0'       # Script 12: macOS user preferences (darwin branch)
# DOTFILES_RUN_WINDOWS_DEFAULTS_SETUP='0'    # Script 12: Windows user preferences (windows branch)
# DOTFILES_RUN_LINUX_DEFAULTS_SETUP='0'      # Script 12: Linux user preferences (linux branch; GNOME/KDE)
# DOTFILES_RUN_SECRETS_SETUP='0'              # Script 14: secrets distribution (migrated from DOTFILES_RUN_OPENCODE_SETUP)
# DOTFILES_RUN_MCP_SETUP='0'                  # Script 15: MCP config generation
# DOTFILES_RUN_MOZART_SETUP='0'               # Script 17: Mozart router config
# DOTFILES_RUN_CODEGRAPH_SETUP='0'            # Script 19: CodeGraph MCP registration
# DOTFILES_RUN_CODEGRAPH_INDEX_SETUP='0'     # Script 19: Batch init .codegraph/ in git repos under ~/Development
# DOTFILES_RUN_AGENT_GUIDANCE_SETUP='0'       # Script 20: agent guidance distribution
# DOTFILES_RUN_SKILLS_SETUP='0'               # Script 28: skills distribution (manifest-driven reconcile against configs/skills/skills.*.json)
# DOTFILES_RUN_SKILLS_AWS_SETUP='0'           # Script 28: AWS agent-toolkit skills profile
# DOTFILES_RUN_SKILLS_MONGODB_SETUP='0'       # Script 28: MongoDB skills profile
# DOTFILES_RUN_SKILLS_PRISMA_SETUP='0'        # Script 28: Prisma skills profile
# Project-scoped configuration (place these in a project's .opencode/.env, not ~/.env)
# .env is user-authored project config; configure-project.py writes generated secrets to
# .opencode/.env.local, which is gitignored and loaded after .env.
# DOTFILES_PROJECT_STEPS='opencode,tier,skills'  # Optional explicit step list; overrides automatic selection
# DOTFILES_PROJECT_PRESET='pro-plus'
# DOTFILES_PROJECT_SKILL_PROFILES='core'
# DOTFILES_PROJECT_SKILLS=''
# DOTFILES_PROJECT_SKIP_SKILLS=''
# DOTFILES_PROJECT_MCPS=''
# DOTFILES_PROJECT_MCP_TOOLS=''
# DOTFILES_PROJECT_CODEGRAPH='true'
# DOTFILES_PROJECT_JETBRAINS='true'
# DOTFILES_PROJECT_JUNIE='true'
# DOTFILES_PROJECT_ACP_AGENTS=''
# DOTFILES_PROJECT_SECRETS='true'
# DOTFILES_RUN_OLLAMA_DAEMON_SETUP='0'          # Script 27: Ollama daemon env vars (OLLAMA_FLASH_ATTENTION, OLLAMA_KV_CACHE_TYPE) — launchctl/systemd/setx
# DOTFILES_RUN_OPENCODE_SETUP='1'             # Script 16: OpenCode config (tier, models, voice)
# configure-all.sh only (not a chezmoi script gate): secrets distribution via configure-secrets.py; enable DOTFILES_RUN_SECRETS_SETUP in ~/.env (inherits from DOTFILES_RUN_OPENCODE_SETUP via migrate-env-gates.py)
# Voice plugin deps (used by scripts/install-opencode.sh):
# DOTFILES_RUN_VOICE_SETUP='0'               # whisper-cpp, sox, piper-tts installs
# DOTFILES_WHISPER_MODEL='ggml-large-v3-turbo.bin'   # Whisper STT model (best balance of accuracy, ~1.5 GiB)
# DOTFILES_PIPER_VOICE='en_US-lessac-high'           # Piper TTS voice
# Phase 4: LAN exposure
# DOTFILES_RUN_CADDY_SETUP='0'              # Caddy reverse proxy (LAN exposure)
# DOTFILES_RUN_DDNS_SETUP='0'               # ddns-route53 (DNS updates); inherits CADDY_SETUP via migrate-env-gates.py
# DOTFILES_RUN_ACME_SETUP='0'               # ACME cert management; inherits CADDY_SETUP via migrate-env-gates.py
# DOTFILES_RUN_PLANNOTATOR_PASTE_SETUP='0'  # Plannotator paste backend; inherits CADDY_SETUP via migrate-env-gates.py
# DOTFILES_RUN_OPENCODE_WEB_SETUP='0'             # Optional OpenCode web LaunchAgent
# --- Tier settings ---
# DOTFILES_USE_LOCAL_OLLAMA='1'
# DOTFILES_USE_OLLAMA_CLOUD_PROXY='1'
# DOTFILES_OPENCODE_TIER='pro-plus'
# DOTFILES_SMALLCODE_TIER='pro-plus'                     # SmallCode tier; auto-detected from API keys if unset (mirrors DOTFILES_OPENCODE_TIER logic)
# DOTFILES_LOCAL_FALLBACK_PRESET='local-pro'             # --local-fallback-preset arg forwarded to configure-opencode-tier.py / configure-smallcode.py
# DOTFILES_LOCAL_FALLBACK_PLACEHOLDERS='reasoning=code-gen,vision=lightweight'  # Comma-separated --local-fallback-placeholder args (role=category)
# DOTFILES_LOCAL_FALLBACK_ROLES='observer=ollama/qwen3.5:9b-mlx'  # Comma-separated --local-fallback-role args (role=model)
# DOTFILES_MIN_REASONING_EMBEDDING='0'                   # Hard-filter local models with embedding_length < N from reasoning roles (0 = disabled; models with unknown embedding_length are never filtered out)
# DOTFILES_ENV_FILE='${HOME}/.env'
# DOTFILES_PROMPT_USER_COLOUR='bold yellow'

# --- Git identity (used by dot_gitconfig.tmpl + gpg.conf.tmpl) ---
# GIT_AUTHOR_NAME='Your Name'
# GIT_AUTHOR_EMAIL='you@example.com'
# GPG_SIGNING_KEY='YOUR_FULL_GPG_FINGERPRINT'

# --- GitHub ---
# GITHUB_USER='your-github-username'
# GH_TOKEN='ghp_...'                         # Canonical GitHub token (also used by gh CLI)
# GITHUB_TOKEN=''                            # Derived at integration boundaries for act and GitHub Copilot CLI; do not configure separately

# --- Anthropic ---
# ANTHROPIC_API_KEY='sk-ant-...'
# NOTE: When using Meridian (OAuth proxy), any non-empty value works —
# the AI SDK requires a key to validate, but Meridian overrides auth.
# Keep ANTHROPIC_BASE_URL set to route requests through the proxy.

# --- Asana ---
# ASANA_API_TOKEN='2/...'

# --- AWS (used by private_dot_aws/credentials.tmpl) ---
# AWS_ACCESS_KEY_ID='AKIA...'
# AWS_SECRET_ACCESS_KEY='...'
# AWS_SESSION_TOKEN='...'             # Optional — set if using temporary credentials
# AWS_DEFAULT_REGION='us-east-1'
# AWS_DEFAULT_PROFILE='your-profile'

# --- Better Stack / Better Uptime ---
# BETTERUPTIME_API_TOKEN='your-token'
# BETTERSTACK_API_TOKEN='your-token'

# --- Bitbucket ---
# BITBUCKET_PRIVATE_TOKEN='your-token'

# --- BrowserStack ---
# BROWSERSTACK_USERNAME='your-username'
# BROWSERSTACK_ACCESS_KEY='your-key'

# --- Docker Hub ---
# DOCKER_HUB_API_TOKEN='dckr_pat_...'

# --- Gemini / Google ---
# GEMINI_API_KEY='AIza...'
# GOOGLE_CLOUD_PROJECT='your-project'

# --- GitLab ---
# GITLAB_API_ENDPOINT='https://gitlab.com/api/v4'
# GITLAB_API_PRIVATE_TOKEN='glpat-...'

# --- JetBrains MCP ---
# IJ_MCP_TRANSPORT='sse'
# IJ_MCP_SERVER_JAVA='/path/to/java'
# IJ_MCP_SERVER_CLASSPATH='/path/to/classpath'

# --- Meridian ---
# MERIDIAN_API_KEY='your-meridian-api-key'
# MERIDIAN_HOST='127.0.0.1'
# MERIDIAN_PORT='3456'

# --- Caddy LAN exposure ---
# CADDY_ACCESS='localhost'                 # Access mode: localhost | lan | public
# CADDY_HTTPS_PORT='443'                    # HTTPS port (443 for root LaunchDaemon, 8443 for user LaunchAgent)
# CADDY_BIND_IP=''                          # Auto: ipconfig getifaddr en0, fallback 0.0.0.0
# CADDY_HOSTNAME=''                         # Auto: chezmoi hostname
#
# Machine-local Caddy v2 config (create per machine; not tracked in git):
#   Auth is only read from ~/.config/caddy/caddy-auth.conf
#   OpenCode web exposes localhost-only; Caddy basic_auth is the external auth boundary.
#   ~/.config/caddy/ddns-zones.json   # Multi-domain DDNS zones + record sets
#   ~/.config/caddy/caddy-auth.conf   # Multi-user auth snippets / includes
# CADDY_ZONES_CONFIG='$HOME/.config/caddy/ddns-zones.json'
# CADDY_AUTH_CONF='$HOME/.config/caddy/caddy-auth.conf'
# ROUTE53_AWS_ACCESS_KEY_ID=''             # Required: AWS key for Route 53 (acme.sh + ddns; can reuse AWS_ACCESS_KEY_ID)
# ROUTE53_AWS_SECRET_ACCESS_KEY=''         # Required: AWS secret for Route 53 (can reuse AWS_SECRET_ACCESS_KEY)
# ACME_EMAIL=''                             # Required: acme.sh account email
# OPENCODE_SERVER_PORT='4096'                # OpenCode Web service's fixed port; used by configure-caddy.py and configure-opencode.py
# PLANNOTATOR_PORT='19432'
# PASTE_PORT='19433'
# PLANNOTATOR_DATA_DIR="$HOME/.plannotator/portal"
# PASTE_DATA_DIR="$HOME/.plannotator/pastes"
# PASTE_TTL_DAYS='30'
# PASTE_MAX_SIZE='10485760'
# PASTE_ALLOWED_ORIGINS='["https://your-hostname"]'

# --- Mozart Router ---
# MOZART_CONFIG='${HOME}/.mozart/mozart.json'

# --- MongoDB Atlas / MCP ---
# MONGODB_ATLAS_PUBLIC_KEY='your-key'
# MONGODB_ATLAS_PRIVATE_KEY='your-secret'
# MDB_MCP_API_CLIENT_ID='your-client-id-or-public-key'
# MDB_MCP_API_CLIENT_SECRET='your-client-secret-or-private-key'

# --- npm ---
# NPM_TOKEN='npm_...'

# --- Ollama ---
# OLLAMA_API_KEY='your-ollama-cloud-key'
# OLLAMA_HOST='http://localhost:11434'        # Canonical upstream-native daemon URL (scheme+host[:port])
# OLLAMA_LOCAL_HOST='localhost'               # Compatibility fallback for scripts needing host and port separately
# OLLAMA_LOCAL_PORT='11434'                   # Compatibility fallback paired with OLLAMA_LOCAL_HOST
# OLLAMA_CLOUD_BASE_URL='https://ollama.com/v1'  # Override Ollama Cloud gateway URL
#
# --- Ollama daemon tuning (applied by Script 27 via launchctl/systemd/setx) ---
# OLLAMA_FLASH_ATTENTION='1'        # Force Flash Attention on. Auto-detected by default on supported hardware; only set to force-enable.
# OLLAMA_KV_CACHE_TYPE='q8_0'       # K/V cache quant (f16|q8_0|q4_0). Requires OLLAMA_FLASH_ATTENTION=1. q8_0 = ~1/2 memory, tiny precision loss. q4_0 = ~1/4, more loss. Global.
# OLLAMA_NUM_PARALLEL='1'           # Max parallel requests per model (default: 1). Memory scales as NUM_PARALLEL × CONTEXT_LENGTH. Server/multi-user knob — leave 1 for desktop.
# OLLAMA_MAX_LOADED_MODELS='3'      # Max models resident concurrently (default: 3×GPUs, or 3 on CPU). Lower to save RAM; raise for multi-model agent workflows with ample VRAM.
# OLLAMA_KEEP_ALIVE='5m'            # How long models stay loaded after last request (default: 5m). Use -1 for always-hot, or shorter to free RAM.
# OLLAMA_CONTEXT_LENGTH=''         # Override default context window size (default: 4096 tokens). Set higher for RAG/long-context workloads, lower to save VRAM. Per-model: use Modelfile `PARAMETER num_ctx` or API `options.num_ctx`.
# OLLAMA_LLM_LIBRARY=''             # Force runtime library (troubleshooting only — e.g. 'cuda_v12', 'rocm'). Auto-detect normally.
# OLLAMA_SCHED_SPREAD='1'           # Spread model across all GPUs (multi-GPU only, niche).
# OLLAMA_ORIGINS=''                 # CORS allowlist (comma-separated) for browser UIs.
# NOTE: OLLAMA_MLX is NOT recommended — MLX is auto-enabled on Apple Silicon in current Ollama.
# NOTE: OLLAMA_KV_CACHE_TYPE requires OLLAMA_FLASH_ATTENTION=1 to take effect.

# --- OpenCode ---
# OPENCODE_DIR='${HOME}/.config/opencode'
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS='true'
# OPENCODE_PORT='49152'                       # Random 49152-65535 multiplexer/editor-pane communication port; used by aliases.sh
#                                             # OPENCODE_PORT and OPENCODE_SERVER_PORT are distinct concepts, not aliases.

# --- SmallCode ---
# SMALLCODE_MODEL_DEFAULT='qwen3:8b'
# SMALLCODE_MODEL_FAST='qwen3:8b'
# SMALLCODE_MODEL_MEDIUM='qwen3:8b'
# SMALLCODE_MODEL_STRONG='qwen3:8b'
# SMALLCODE_BASE_URL_DEFAULT and SMALLCODE_BASE_URL_* are auto-generated by configure-smallcode.py
# SMALLCODE_PROVIDER='openai'
# SMALLCODE_CONTEXT_BUDGET='67'
# SMALLCODE_CONTEXT_WINDOW='128000'
# SMALLCODE_BASH_TIMEOUT='30'
# SMALLCODE_MODEL_TIMEOUT='300'
# SMALLCODE_THEME='dark'
# SMALLCODE_AUTO_COMMIT='false'
# SMALLCODE_ESCALATION_CONFIRM='true'
# SMALLCODE_ESCALATION_MAX='5'
# SMALLCODE_WEB_BROWSE='true'
# SMALLCODE_SHOW_THINKING='false'
# SMALLCODE_SHELL_PERSIST='false'
# SMALLCODE_EVIDENCE_DISABLE='false'

# --- OpenAI ---
# OPENAI_API_KEY='sk-...'

# --- Perfecto ---
# PERFECTO_USERNAME='you@example.com'
# PERFECTO_PASSWORD='your-password'

# --- Sauce Labs ---
# SAUCE_USERNAME='your-username'
# SAUCE_ACCESS_KEY='your-key'

# --- Sentry ---
# SENTRY_AUTH_TOKEN='sntryu_...'       # Canonical name; MCP exports as SENTRY_ACCESS_TOKEN

# --- Context7 MCP ---
# Context7 MCP — optional, anonymous works without it; enables higher rate limits
# CONTEXT7_API_KEY=''

# --- Shortcut ---
# SHORTCUT_API_TOKEN='your-token'

# --- TestRigor ---
# TESTRIGOR_TOKEN='...'

# --- TestObject ---
# TESTOBJECT_ACCESS_KEY='your-key'

# --- Trello ---
# TRELLO_API_TOKEN='your-token'
# TRELLO_API_KEY='your-key'

# --- VueScan ---
# VUESCAN_USER_ID='your-uuid'
# VUESCAN_LICENSE='your-license'
# VUESCAN_CUSTOMER='your-customer-number'
# VUESCAN_EMAIL='you@example.com'
