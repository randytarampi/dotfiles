# dot_dotfiles/shell/.env.example
# Copy to ~/.env and fill in real values. This file is the canonical template
# for secrets, provider tokens, and dotfiles toggles.
# DO NOT commit .env — it is gitignored.
#
# Format: KEY='VALUE' (single-quoted, no "export" keyword)
# Loaded at shell startup via: set -a && source "$HOME/.env" && set +a

# --- Standard shell/shared settings ---
# LC_ALL='en_CA.UTF-8'
# LANG='en_CA.UTF-8'
# LANGUAGE='en_CA.UTF-8'
# EDITOR='emacs'
# VISUAL='emacs'
# HISTCONTROL='ignoreboth'
# HISTSIZE='1000'
# HISTFILESIZE='2000'
# ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX='YES'
# CLICOLOR='1'
# GREP_COLOR='1'
# GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# --- Provider base-URL overrides (official SDK env vars) ---
# When set, these take priority over hardcoded provider URLs in all scripts.
# ANTHROPIC_BASE_URL='https://api.anthropic.com/v1'   # Anthropic SDK; also signals Meridian usage
# OPENAI_BASE_URL='https://api.openai.com/v1'          # OpenAI SDK

# --- Telemetry opt-out ---
# OPENSPEC_TELEMETRY='0'
# DO_NOT_TRACK='1'

# --- Dotfiles toggles (0 = skip, 1 = run during chezmoi apply / make deploy) ---
# Gates follow DOTFILES_RUN_*_SETUP pattern. Default 0 (opt-in) for fleet management.
# Phase 1: One-time setup (run_once_01-03) — no gates needed for 01, 03
# DOTFILES_RUN_MACOS_SECURITY_SETUP='0'       # Script 02: firewall, Gatekeeper, FileVault
# Phase 2: Package/CLI installs (run_onchange_04-11)
# DOTFILES_RUN_PACKAGES_SETUP='0'             # Script 04: Homebrew/Winget packages
# DOTFILES_RUN_JUNIE_CLI_SETUP='1'            # Script 06: Junie CLI + model profiles
# DOTFILES_RUN_OPENCODE_TOOLS_SETUP='1'       # Scripts 07, 08: OpenCode plugins + CLI tools
# DOTFILES_RUN_PLANNOTATOR_SETUP='1'          # Script 09: Plannotator CLI
# DOTFILES_RUN_SMALLCODE_SETUP='1'            # Scripts 10, 18: SmallCode install + config
# DOTFILES_RUN_MERIDIAN_SETUP='0'             # Script 11: Meridian launchd plist (macOS)
# Phase 3: Tool configuration (run_onchange_12-20)
# DOTFILES_RUN_MACOS_DEFAULTS_SETUP='0'       # Script 12: macOS user preferences
# DOTFILES_RUN_OPENCODE_SETUP='1'             # Scripts 14, 16: secrets + OpenCode config
# DOTFILES_RUN_MCP_SETUP='1'                  # Script 15: MCP config generation
# DOTFILES_RUN_MOZART_SETUP='1'               # Script 17: Mozart router config
# DOTFILES_RUN_CODEGRAPH_SETUP='1'            # Script 19: CodeGraph MCP registration
# DOTFILES_RUN_AGENT_GUIDANCE_SETUP='1'       # Script 20: agent guidance distribution
# configure-all.sh only (not a chezmoi script gate):
# DOTFILES_RUN_SECRETS_SETUP='1'              # configure-ai.py in configure-all.sh
# Voice plugin deps (used by scripts/install-opencode.sh):
# DOTFILES_RUN_VOICE_SETUP='0'               # whisper-cpp, sox, piper-tts installs
# --- Tier settings ---
# DOTFILES_USE_LOCAL_OLLAMA='1'
# DOTFILES_USE_OLLAMA_CLOUD_PROXY='1'
# DOTFILES_OPENCODE_TIER='pro-plus'
# DOTFILES_ENV_FILE='${HOME}/.env'
# DOTFILES_PROMPT_USER_COLOUR='bold yellow'

# --- Git identity (used by dot_gitconfig.tmpl + gpg.conf.tmpl) ---
# GIT_AUTHOR_NAME='Your Name'
# GIT_AUTHOR_EMAIL='you@example.com'
# GPG_SIGNING_KEY='YOUR_FULL_GPG_FINGERPRINT'

# --- GitHub ---
# GITHUB_USER='your-github-username'
# GH_TOKEN='ghp_...'

# --- Anthropic ---
# ANTHROPIC_API_KEY='sk-ant-...'

# --- Asana ---
# ASANA_API_TOKEN='2/...'

# --- AWS (used by private_dot_aws/credentials.tmpl) ---
# AWS_ACCESS_KEY_ID='AKIA...'
# AWS_SECRET_ACCESS_KEY='...'
# AWS_SESSION_TOKEN='...'             # Optional — set if using temporary credentials
# AWS_DEFAULT_REGION='us-east-1'
# AWS_DEFAULT_PROFILE='your-profile'

# --- Better Stack / Better Uptime ---
# BETTERUPTIME_API_TOKEN='your-token'
# BETTERSTACK_API_TOKEN='your-token'

# --- Bitbucket ---
# BITBUCKET_PRIVATE_TOKEN='your-token'

# --- BrowserStack ---
# BROWSERSTACK_USERNAME='your-username'
# BROWSERSTACK_ACCESS_KEY='your-key'

# --- Docker Hub ---
# DOCKER_HUB_API_TOKEN='dckr_pat_...'

# --- Gemini / Google ---
# GEMINI_API_KEY='AIza...'
# GOOGLE_CLOUD_PROJECT='your-project'

# --- GitLab ---
# GITLAB_API_ENDPOINT='https://gitlab.com/api/v4'
# GITLAB_API_PRIVATE_TOKEN='glpat-...'

# --- JetBrains MCP ---
# IJ_MCP_TRANSPORT='sse'
# IJ_MCP_SERVER_JAVA='/path/to/java'
# IJ_MCP_SERVER_CLASSPATH='/path/to/classpath'

# --- Meridian ---
# MERIDIAN_API_KEY='your-meridian-api-key'
# MERIDIAN_HOST='127.0.0.1'
# MERIDIAN_PORT='3456'

# --- Mozart Router ---
# MOZART_CONFIG='${HOME}/.mozart/mozart.json'

# --- MongoDB Atlas / MCP ---
# MONGODB_ATLAS_PUBLIC_KEY='your-key'
# MONGODB_ATLAS_PRIVATE_KEY='your-secret'
# MDB_MCP_API_CLIENT_ID='your-client-id-or-public-key'
# MDB_MCP_API_CLIENT_SECRET='your-client-secret-or-private-key'

# --- npm ---
# NPM_TOKEN='npm_...'

# --- Ollama ---
# OLLAMA_API_KEY='your-ollama-cloud-key'
# OLLAMA_LOCAL_HOST='localhost'
# OLLAMA_LOCAL_PORT='11434'
# OLLAMA_HOST='http://localhost:11434'          # Official Ollama env var (scheme+host[:port]); overrides OLLAMA_LOCAL_HOST/PORT
# OLLAMA_CLOUD_BASE_URL='https://ollama.com/v1'  # Override Ollama Cloud gateway URL

# --- OpenCode ---
# OPENCODE_DIR='${HOME}/.config/opencode'
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS='true'
# OPENCODE_PORT='49152'

# --- SmallCode ---
# SMALLCODE_MODEL_DEFAULT='qwen3:8b'
# SMALLCODE_MODEL_FAST='qwen3:8b'
# SMALLCODE_MODEL_MEDIUM='qwen3:8b'
# SMALLCODE_MODEL_STRONG='qwen3:8b'
# SMALLCODE_BASE_URL_DEFAULT and SMALLCODE_BASE_URL_* are auto-generated by configure-smallcode.py
# SMALLCODE_PROVIDER='openai'
# SMALLCODE_CONTEXT_BUDGET='67'
# SMALLCODE_CONTEXT_WINDOW='128000'
# SMALLCODE_BASH_TIMEOUT='30'
# SMALLCODE_MODEL_TIMEOUT='300'
# SMALLCODE_THEME='dark'
# SMALLCODE_AUTO_COMMIT='false'
# SMALLCODE_ESCALATION_CONFIRM='true'
# SMALLCODE_ESCALATION_MAX='5'
# SMALLCODE_WEB_BROWSE='true'
# SMALLCODE_SHOW_THINKING='false'
# SMALLCODE_SHELL_PERSIST='false'
# SMALLCODE_EVIDENCE_DISABLE='false'

# --- OpenAI ---
# OPENAI_API_KEY='sk-...'

# --- Perfecto ---
# PERFECTO_USERNAME='you@example.com'
# PERFECTO_PASSWORD='your-password'

# --- Sauce Labs ---
# SAUCE_USERNAME='your-username'
# SAUCE_ACCESS_KEY='your-key'

# --- Sentry ---
# SENTRY_AUTH_TOKEN='sntryu_...'       # Canonical name; MCP exports as SENTRY_ACCESS_TOKEN

# --- Shortcut ---
# SHORTCUT_API_TOKEN='your-token'

# --- TestObject ---
# TESTOBJECT_ACCESS_KEY='your-key'

# --- Trello ---
# TRELLO_API_TOKEN='your-token'
# TRELLO_API_KEY='your-key'

# --- VueScan ---
# VUESCAN_USER_ID='your-uuid'
# VUESCAN_LICENSE='your-license'
# VUESCAN_CUSTOMER='your-customer-number'
# VUESCAN_EMAIL='you@example.com'
