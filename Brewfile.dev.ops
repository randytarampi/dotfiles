# --- Brews ---
brew "arping"
brew "awscli"
# No service declaration: scripts/caddy-setup.sh owns Caddy through the root
# LaunchDaemon com.caddy.proxy (docs/caddy.md). Homebrew's generated agent
# points at $(brew --prefix)/etc/Caddyfile, which this setup never writes, so it
# crash-loops against the real config at $(brew --prefix)/etc/caddy/Caddyfile and
# reports an error state in `brew services list`.
brew "caddy"
brew "certbot"
brew "cloudflare-speed-cli"
brew "duckdb"
brew "glances"
brew "fping"
brew "hey"
brew "hf"
brew "inetutils"
brew "iperf3"
brew "iproute2mac"
brew "k6"
brew "kubernetes-cli"
brew "libgphoto2"
brew "mailutils"
brew "mongosh"
brew "postgresql@16"
brew "pulumi/tap/pulumi", trusted: true
brew "ssh-audit"
brew "grype"
brew "syft"

# --- Shared tap formulas (from core Brewfile) ---
brew "heroku/brew/heroku", trusted: true

# --- Casks ---
cask "gcloud-cli"

# --- npm ---
npm "speed-cloudflare-cli"