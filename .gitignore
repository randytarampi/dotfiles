# Secrets
.env
*.env
!.chezmoi.toml.tmpl

# iTerm2's full preferences plist can include command history and secrets.
/dot_com.googlecode.iterm2.plist

# chezmoi runtime
.chezmoi-cache/

# Local Python development environment
.venv/

# Generated ACP agent config (emitted by configure-acp-agents.py)
configs/opencode/acp-agents.json

# Deepwork progress state (kept git-local; OpenCode-readable via .ignore)
.slim/deepwork/

# Gemini CLI GitHub Action runtime state (gha-creds are OAuth artifacts)
.gemini/
gha-creds-*.json

# Tracked CI config (global opencode.json ignore must not hide it)
!configs/opencode/ci/
!configs/opencode/ci/opencode.json
