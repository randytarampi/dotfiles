# wingetfile — Windows packages
# Format: one PackageIdentifier per line
# Comments start with #
# Categories mirror Brewfile categories where applicable

# --- Languages & build ---
# Cross-ref: brew 'python@3.12'
Python.Python.3.12

# --- Dev tools ---
# Cross-ref: brew cask 'docker-desktop'
Docker.DockerCLI
# Cross-ref: brew cask 'copilot-cli'
GitHub.Copilot
# Cross-ref: brew cask 'codex'
OpenAI.Codex
# OpenCode: official install script owns the channel; no v2 winget package exists (verified 2026-10-31).
# Cross-ref: brew cask 'jetbrains-toolbox' (bundled JetBrains tools)
JetBrains.dotPeek
# Cross-ref: brew cask 'jetbrains-toolbox' (bundled JetBrains tools)
JetBrains.dotTrace
# Cross-ref: brew cask 'ollama-app'
Ollama.Ollama
# Cross-ref: brew 'fastfetch'
Fastfetch-cli.Fastfetch
# Cross-ref: brew 'visual-studio-code'
Microsoft.VisualStudioCode
# Cross-ref: brew 'black'
psf.black
