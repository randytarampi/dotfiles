# EditorConfig is awesome: http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[.chezmoiscripts/*]
indent_style = space
indent_size = 2

[.chezmoidata/*]
indent_size = 2

[configs/**]
indent_size = 2

[scripts/**]
indent_style = space
indent_size = 2

[**/node_modules/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[**/{dist,build,coverage,.idea,.chezmoi-cache}/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
