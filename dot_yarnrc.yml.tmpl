# ~/.yarnrc.yml — managed by chezmoi
# Yarn Berry (modern) configuration
# Token references resolve from ~/.env at shell startup

npmRegistries:
  "https://registry.yarnpkg.com":
    {{- if env "NPM_TOKEN" }}
    npmAuthToken: {{ env "NPM_TOKEN" }}
    {{- end }}
  "https://npm.pkg.github.com":
    {{- if or (env "GH_TOKEN") (env "GITHUB_TOKEN") }}
    npmAuthToken: {{ env "GH_TOKEN" | default (env "GITHUB_TOKEN") }}
    {{- end }}
