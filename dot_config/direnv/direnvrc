# shellcheck shell=bash
# direnv configuration

# Make direnv layout commands available
layout_python() {
    if [[ -d .venv ]]; then
        PATH_add .venv/bin
        # shellcheck disable=SC2155
        export VIRTUAL_ENV="$(pwd)/.venv"
    else
        local python="${1:-python3}"
        local venv=".venv"
        $python -m venv "$venv"
        PATH_add "$venv/bin"
        # shellcheck disable=SC2155
        export VIRTUAL_ENV="$(pwd)/$venv"
    fi
}

layout_node() {
    if [[ -f .nvmrc ]]; then
        # shellcheck disable=SC2155
        export NODE_VERSION="$(cat .nvmrc)"
    fi
    PATH_add node_modules/.bin
}

# Use .envrc.local for local overrides
if [[ -f .envrc.local ]]; then
    source .envrc.local
fi
