# Starship prompt configuration
# Mirrors the fallback prompt in dot_dotfiles/shell/prompt.sh:
#   - When starship is available, it takes over via `eval "$(starship init bash)"`
#   - When starship is absent, prompt.sh falls back to debian_chroot + user@host:path$
# This config replicates that layout: user@host path git info ❯

format = """
$username@$hostname $directory$git_branch$git_status\
$cmd_duration\
$line_break\
$character"""

[username]
style_user = "{{ env "DOTFILES_PROMPT_USER_COLOUR" | default "bold yellow" }}"
style_root = "bold red"
format = "[$user]($style)"
show_always = true
disabled = false

[hostname]
ssh_only = false
format = "[$hostname]($style)"
style = "bold dimmed green"
disabled = false

[directory]
style = "bold blue"
truncation_length = 3
truncate_to_repo = true
fish_style_pwd_dir_length = 1
format = "[$path]($style)"
disabled = false

[git_branch]
symbol = ""
style = "bold purple"
format = " [$symbol$branch]($style)"
disabled = false

[git_status]
style = "bold red"
format = "[$all_status$ahead_behind]($style) "
disabled = false

[nodejs]
symbol = "node "
style = "bold green"
format = "[$symbol($version)]($style) "
disabled = false

[python]
symbol = "python "
style = "bold yellow"
format = "[$symbol($version)]($style) "
disabled = false

[rust]
symbol = "rust "
style = "bold orange"
format = "[$symbol($version)]($style) "
disabled = false

[golang]
symbol = "go "
style = "bold cyan"
format = "[$symbol($version)]($style) "
disabled = false

[cmd_duration]
min_time = 500
format = " took [$duration]($style)"
style = "bold yellow"
disabled = false

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
disabled = false

# Disable cloud/container modules (not needed on workstations)
[aws]
disabled = true

[container]
disabled = true

[docker_context]
disabled = true

[gcloud]
disabled = true
